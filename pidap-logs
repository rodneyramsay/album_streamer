#!/bin/sh

LOG_DIR="/usr/local/Music/pidap-logs"
TMP_DIR="/tmp/pidap-logs-$$"

mkdir -p "$TMP_DIR" || { echo "Cannot create temp dir" >&2; exit 1; }

log_file() {
    _name=$1
    _cmd=$2
    echo "===== $_name =====" > "$TMP_DIR/$_name.txt"
    eval "$_cmd" >> "$TMP_DIR/$_name.txt" 2>&1
    echo "" >> "$TMP_DIR/$_name.txt"
}

log_file "dmesg" "dmesg"
log_file "dmesg_time" "dmesg -T"
log_file "uptime" "uptime"
log_file "mount" "mount"
log_file "df" "df -h"
log_file "cpuinfo" "cat /proc/cpuinfo"
log_file "meminfo" "cat /proc/meminfo"
log_file "cmdline" "cat /proc/cmdline"
log_file "fstab" "cat /etc/fstab"
log_file "init_d" "ls -l /etc/init.d"
log_file "ps" "ps -o pid,comm,args 2>/dev/null || ps -o pid,comm || ps"
log_file "lsmod" "lsmod"
log_file "env" "env"
log_file "interfaces" "cat /etc/network/interfaces 2>/dev/null || echo no interfaces"

rm -rf "$LOG_DIR"
mkdir -p "$LOG_DIR" || { echo "Cannot create $LOG_DIR" >&2; rm -rf "$TMP_DIR"; exit 1; }

cp -r "$TMP_DIR"/* "$LOG_DIR/"
rm -rf "$TMP_DIR"

echo "$LOG_DIR"
