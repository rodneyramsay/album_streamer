image boot.vfat {
	vfat {
		extraargs = "-F 32"
#BOOT_FILES#
	}

	size = 128M
}

image sdcard.img {
	hdimage {
	}

	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
	}

	partition rootfs {
		partition-type = 0x83
		image = "rootfs.ext2"
	}

	# Writable user partition for music / Perl scripts
	partition user-data {
		partition-type = 0x83
		image = "user-data.ext4"
	}
}
