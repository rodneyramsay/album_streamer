sub start_gpio_handler() {

   my $handler = "$FindBin::Bin/pidap-buttons";

   unless(-r $handler) {
      print "Warning: $handler not found, button control disabled\n";
      return 0;
   }

   print "Forking GPIO button handler: $handler\n";

   my $pid = fork;
   die "Failed to fork GPIO handler\n" unless defined $pid;

   if($pid == 0) {
      exec("perl", $handler) or die "Failed to exec $handler: $!\n";
   }

   print "GPIO handler pid: $pid\n";
   return $pid;
}

sub start_menu() {

   my $handler = "$FindBin::Bin/pidap-menu";

   unless(-r $handler) {
      print "Warning: $handler not found, menu disabled\n";
      return 0;
   }

   print "Forking menu handler: $handler\n";

   my $pid = fork;
   die "Failed to fork menu handler\n" unless defined $pid;

   if($pid == 0) {
      exec("perl", $handler) or die "Failed to exec $handler: $!\n";
   }

   print "Menu handler pid: $pid\n";
   return $pid;
}

sub build_playlist() {

   my $builder = "$FindBin::Bin/pidap-playlist";

   unless(-r $builder) {
      print "Warning: $builder not found\n";
      return 0;
   }

   print "Building playlist: $builder\n";

   my $rc = system("perl", $builder);
   if ($rc != 0) {
      print "Warning: $builder returned non-zero ($rc)\n";
   }

   return 1;
}

sub is_gpio_low {
    my ($val) = @_;
    return 0 unless defined $val;
    return 1 if $val eq '0';
    return 1 if $val =~ /^(inactive|off|low)$/i;
    return 0;
}

sub read_boot_gpio() {

   my @cmd = ('gpioget', '-c', 'gpiochip0', '--bias=pull-up', 5, 6, 16, 24);
   print "Boot GPIO: running @cmd\n";
   my $out = `@cmd 2>/dev/null`;
   print "Boot GPIO (bias): $out\n" if defined $out;
   unless (defined $out && $out =~ /\S/) {
      my @plain = ('gpioget', '-c', 'gpiochip0', 5, 6, 16, 24);
      print "Boot GPIO: falling back to @plain\n";
      $out = `@plain 2>/dev/null`;
      print "Boot GPIO (plain): $out\n" if defined $out;
   }
   unless (defined $out && $out =~ /\S/) {
      print "Boot GPIO: no readable button state\n";
      return '';
   }

   my @pin_order = (5, 6, 16, 24);
   my @labels = ('A', 'B', 'X', 'Y');
   my %state = ();

   # libgpiod 2.x style: "5"=active "6"=inactive ...
   for my $tok (split /\s+/, $out) {
      if ($tok =~ /^"(\d+)"=(\S+)$/) {
         $state{$1} = $2;
      }
   }

   # Older style: one value per line (0/1) in pin order.
   unless (%state) {
      my @vals = split /\s+/, $out;
      for my $i (0 .. $#pin_order) {
         $state{$pin_order[$i]} = $vals[$i] if defined $vals[$i];
      }
   }

   for my $i (0 .. $#pin_order) {
      my $pin = $pin_order[$i];
      next unless exists $state{$pin};
      if (&is_gpio_low($state{$pin})) {
         print "Boot GPIO: button $labels[$i] held ($pin = $state{$pin})\n";
         return $labels[$i] if $labels[$i] =~ /^(A|B|X)$/;
      }
   }
   print "Boot GPIO: no A/B/X button held\n";
   return '';
}

sub find_usb_partitions {

   my @found = ();
   my $lsblk = `lsblk -P -o PATH,PKNAME,TYPE,TRAN,FSTYPE,MOUNTPOINT,RM,HOTPLUG,MODEL 2>/dev/null`;
   unless (defined $lsblk && $lsblk =~ /\S/) {
      print "find_usb_partitions: lsblk produced no output\n";
      return @found;
   }
   print "find_usb_partitions: lsblk output:\n$lsblk\n";

   # First pass: build a map of parent disk attributes (RM/HOTPLUG/TRAN).
   my %parent = ();
   for my $line (split /\n/, $lsblk) {
      next unless $line =~ /\S/;
      my %f = ();
      while ($line =~ /(\w+)="([^"]*)"/g) {
         $f{$1} = $2;
      }
      next unless $f{TYPE} && $f{TYPE} eq 'disk';
      my $name = $f{PATH};
      $name =~ s#^.*/##;
      $parent{$name} = \%f;
   }

   # Second pass: find candidate partitions.
   for my $line (split /\n/, $lsblk) {
      next unless $line =~ /\S/;
      my %f = ();
      while ($line =~ /(\w+)="([^"]*)"/g) {
         $f{$1} = $2;
      }
      next unless $f{TYPE} && $f{TYPE} eq 'part';

      # Accept an already-mounted USB if it lives under /media/USBxx.
      # Otherwise only consider partitions that are not mounted.
      my $already_mounted = ($f{MOUNTPOINT} && $f{MOUNTPOINT} =~ m#^/media/USB\d+$#);
      next if $f{MOUNTPOINT} && $f{MOUNTPOINT} =~ /\S/ && !$already_mounted;

      # Inherit removable/USB flags from the parent disk if the partition
      # itself doesn't have them.
      my $p = ($f{PKNAME} && exists $parent{$f{PKNAME}}) ? $parent{$f{PKNAME}} : \%f;
      my $is_removable = ($p->{RM} && $p->{RM} eq '1') || ($p->{HOTPLUG} && $p->{HOTPLUG} eq '1');
      my $is_usb = $p->{TRAN} && $p->{TRAN} =~ /^(usb|sata|ata)$/i;
      my $why = $is_removable ? 'removable' : ($is_usb ? 'usb/sata' : 'no');
      print "find_usb_partitions: $f{PATH} hotplug=$why\n";
      next unless $is_removable || $is_usb;

      my $fs = $f{FSTYPE};
      unless ($fs && $fs =~ /^(vfat|exfat|ntfs|ext4|btrfs|xfs|auto)/i) {
         $fs = `blkid -s TYPE -o value "$f{PATH}" 2>/dev/null`;
         chomp($fs) if $fs;
      }
      unless ($fs && $fs =~ /^(vfat|exfat|ntfs|ext4|btrfs|xfs)/i) {
         print "find_usb_partitions: $f{PATH} unsupported or unknown fs '$fs', skipping\n";
         next;
      }

      # Return the existing mount point if it's already in /media, else the
      # device path so we can mount it ourselves.
      my $root = $already_mounted ? $f{MOUNTPOINT} : $f{PATH};
      print "find_usb_partitions: $f{PATH} looks good (fs=$fs, using $root)\n";
      push @found, $root;
   }

   return @found;
}

sub mount_usb_devices {

   my @usb_mounts = ();
   my @parts = &find_usb_partitions();
   return @usb_mounts unless @parts;

   `mkdir -p /media` unless -d '/media';

   # Remove leftover empty USB mount directories from previous runs so we
   # don't accumulate /media/USB01, /media/USB02, ... every time the
   # playlist generator runs.
   for my $old (glob '/media/USB*') {
      next unless -d $old;
      # /proc/mounts lists all active mounts; this works even if mountpoint(1)
      # is not installed.
      my $in_mtab = `grep -F " $old " /proc/mounts 2>/dev/null`;
      next if $in_mtab =~ /\S/;
      if (rmdir($old)) {
         print "Removed stale mount dir $old\n";
      } else {
         print "Warning: could not rmdir $old: $!\n";
      }
   }

   my $n = 1;
   for my $part (@parts) {
      my $dir;
      if ($part =~ m#^/media/USB\d+$# && -d $part) {
         # Already mounted from a previous run (or manually).
         $dir = $part;
         print "Using existing USB mount $dir\n";
      } else {
         do {
            $dir = sprintf('/media/USB%02d', $n++);
         } while (-d $dir);
         `mkdir -p "$dir"`;

         my $rc = system('mount', $part, $dir);
         if ($rc != 0) {
            my $fs = `blkid -s TYPE -o value "$part" 2>/dev/null`;
            chomp($fs) if $fs;
            $fs = 'auto' unless $fs;
            $rc = system('mount', '-t', $fs, $part, $dir);
         }

         if ($rc != 0) {
            print "Warning: failed to mount $part\n";
            rmdir($dir) if -d $dir;
            next;
         }
         print "Mounted USB partition $part on $dir\n";
      }
      push @usb_mounts, $dir;
   }

   my $mfile = "$RUN_DIR/pidap.generated.usb_mounts";
   if (@usb_mounts) {
      if (open(my $uf, '>', $mfile)) {
         print $uf "$_\n" for @usb_mounts;
         close($uf);
      }
   } else {
      unlink($mfile) if -e $mfile;
   }

   return @usb_mounts;
}

sub add_usb_music_roots {

   my (@usb_dirs) = @_;

   # Add each mounted USB's music tree as an extra root. If the USB has a
   # top-level Music directory, use it; otherwise use the mount point itself.
   for my $dir (@usb_dirs) {
      my $root = $dir;
      my $music_root = "$dir/Music";
      if (-d $music_root) {
         $root = $music_root;
         print "Using $music_root as music root for $dir\n";
      }
      push @mounts, $root;
      print "Added music root: $root\n";
   }
}


sub write_play_pid() {

   my ($pid) = (@_);

   return unless $pid;

   open(PIDF, ">$play_pid_file") or return;
   print PIDF "$pid\n";
   close(PIDF);
}


sub set_initial_volume {

   my $control = $ENV{PIDAP_VOLUME_CONTROL} || 'Amp';
   my $initial = $ENV{PIDAP_INITIAL_VOLUME} || 40;
   my $max = 60;
   my $attempt = 0;

   while($attempt < $max) {
      my $out = qx{amixer sset $control ${initial}% 2>&1};
      my $rc = $?;
      if($out =~ /\[${initial}%\]/) {
	 print("Initial volume set to ${initial}%\n");
	 return 1;
      }
      if($attempt == 0) {
	 if(open(my $log, '>', '/tmp/pidap_volume.log')) {
	    print $log "set_initial_volume: amixer sset $control ${initial}% failed (rc=$rc):\n$out\n";
	    my $scontrols = qx{amixer scontrols 2>&1};
	    print $log "amixer scontrols:\n$scontrols\n";
	    close($log);
	 }
	 print("set_initial_volume: amixer sset $control ${initial}% failed (rc=$rc):\n$out");
	 my $scontrols = qx{amixer scontrols 2>&1};
	 print("amixer scontrols:\n$scontrols");
      }
      Time::HiRes::usleep(200_000);
      $attempt++;
   }

   print("Warning: could not set initial volume to ${initial}%, continuing anyway\n");
   return 1;
}


sub read_resume {
   my ($album, $offset) = ('', 0);
   if (-r $resume_file) {
      if (open(my $rf, '<', $resume_file)) {
         while (<$rf>) {
            chomp;
            if (/^album=(.+)/) { $album = $1; }
            elsif (/^offset=([0-9.]+)/) { $offset = $1; }
         }
         close($rf);
      }
   }
   return ($album, $offset);
}


sub read_playlist_file {
   my ($file) = @_;
   my @paths = ();
   if (open(my $pf, '<', $file)) {
      while (<$pf>) {
         chomp;
         next unless $_;
         if (m/^\s*(?:CUESHEET:\s*)?\d+\s+(.+)$/) {
            push @paths, $1;
         } elsif (m/^(.+)$/) {
            push @paths, $1;
         }
      }
      close($pf);
   }
   return @paths;
}

sub read_place_file {
   my ($file) = @_;
   return 0 unless -r $file;
   if (open(my $pf, '<', $file)) {
      my $line = <$pf>;
      close($pf);
      return 0 unless defined $line;
      chomp $line;
      return $1 if $line =~ /^(\d+)$/;
   }
   return 0;
}

sub write_place_file {
   my ($file, $index) = @_;
   if (open(my $pf, '>', $file)) {
      print $pf "$index\n";
      close($pf);
   } else {
      print "Warning: could not write $file: $!\n";
   }
}

sub find_play_child {
   my ($ppid) = @_;
   my $dh;
   return 0 unless opendir($dh, '/proc');
   while (my $pid = readdir($dh)) {
      next unless $pid =~ /^\d+$/;
      next if $pid == $$;
      my $ppid_in_status = 0;
      if (open(my $st, '<', "/proc/$pid/status")) {
         while (<$st>) {
            $ppid_in_status = $1 if /^PPid:\s*(\d+)/;
         }
         close($st);
      }
      next unless $ppid_in_status == $ppid;
      my $comm = '';
      if (open(my $c, '<', "/proc/$pid/comm")) {
         $comm = <$c>;
         chomp($comm) if defined($comm);
         close($c);
      }
      return $pid if $comm =~ /^(sox|play|aplay)$/;
      my $found = &find_play_child($pid);
      return $found if $found;
   }
   closedir($dh);
   return 0;
}

sub start_playback {
   my ($play_album, $play_start_offset, $files, $durations) = @_;
   &write_current_album($play_album, $play_start_offset, $files, $durations, $current_album_file);
   my $cmd = &build_resume_cmd($play_album, $play_start_offset, $files, $durations);
   return 0 unless $cmd;
   return &print_run($cmd);
}

sub resolve_previous_track {
   my ($play_album, $play_start_offset, $album_time, $offsets, $current_ii, $albums_ref, $album_offsets_cache_ref) = @_;
   unlink(qq#${RUN_DIR}/pidap.generated.previous_track#) if -e qq#${RUN_DIR}/pidap.generated.previous_track#;
   my $track_idx = 0;
   for my $i (0 .. $#$offsets) {
      last if $offsets->[$i] > $album_time;
      $track_idx = $i;
   }
   my $track_start = $offsets->[$track_idx];
   my $track_time = $album_time - $track_start;
   if ($track_time > 5) {
      $resume_album = $play_album;
      $resume_offset = $track_start;
   } elsif ($track_idx > 0) {
      $resume_offset = $offsets->[$track_idx - 1];
      $resume_album = $play_album;
   } else {
      my $prev_ii = ($current_ii - 1 + @$albums_ref) % @$albums_ref;
      $resume_album = $albums_ref->[$prev_ii];
      my $prev_entry;
      if (exists $album_offsets_cache_ref->{$albums_ref->[$prev_ii]}) {
         $prev_entry = $album_offsets_cache_ref->{$albums_ref->[$prev_ii]};
      } else {
         $prev_entry = [&get_album_offsets($albums_ref->[$prev_ii])];
         $album_offsets_cache_ref->{$albums_ref->[$prev_ii]} = $prev_entry;
      }
      my $poff = $prev_entry->[2];
      $resume_offset = ($poff && @$poff) ? $poff->[-1] : 0;
   }
   return 1;
}

sub monitor_playback {
   my ($play_id, $play_start_offset, $play_album, $offsets, $current_ii, $albums_ref, $album_offsets_cache_ref, $sel, $menu_out_fh, $pause_fh) = @_;
   my @albums = @$albums_ref;
   my $start_time = Time::HiRes::time();
   my $track_blink_until = 0;
   my $next_offset_idx = 0;
   my $POLL = $ENV{PIDAP_MONITOR_POLL} || 0.5;
   for my $i (0 .. $#$offsets) {
      last if $offsets->[$i] > $play_start_offset + 0.05;
      $next_offset_idx = $i + 1;
   }
   if ($play_start_offset > 0.05) {
      for my $i (0 .. $#$offsets) {
         if (abs($offsets->[$i] - $play_start_offset) < 0.05) {
            &led_track_blink();
            $track_blink_until = $start_time + 0.15;
            last;
         }
      }
   }
   my $paused = 0;
   my $pause_start = 0;
   my $total_pause_time = 0.0;
   my $do_previous = 0;
   my $do_restart = 0;
   my $do_menu_select = 0;
   while ($play_id > 0) {
      my $res = waitpid($play_id, WNOHANG);
      if ($res == 0) {
         if ($g_skip_track) {
            $g_skip_track = 0;
            if ($next_offset_idx <= $#$offsets) {
               $resume_album = $play_album;
               $resume_offset = $offsets->[$next_offset_idx];
            } else {
               my $next_ii = ($current_ii + 1) % @albums;
               $resume_album = $albums[$next_ii];
               $resume_offset = 0;
            }
            $do_restart = 1;
            &led_track_blink();
            $track_blink_until = Time::HiRes::time() + 0.15;
            kill(9, -$play_id) if $play_id > 0;
         } elsif ($g_prev_or_restart) {
            $g_prev_or_restart = 0;
            my $now = $g_prev_or_restart_time;
            my $effective_pause = $total_pause_time + ($paused ? ($now - $pause_start) : 0);
            my $album_time = $play_start_offset + ($now - $start_time - $effective_pause);
            my $track_idx = 0;
            for my $i (0 .. $#$offsets) {
               last if $offsets->[$i] > $album_time;
               $track_idx = $i;
            }
            my $track_start = $offsets->[$track_idx];
            my $track_time = $album_time - $track_start;
            if ($track_idx == 0 && $track_time <= 5) {
               $do_previous = 1;
            } else {
               $do_restart = 1;
               $resume_album = $play_album;
               $resume_offset = 0;
            }
            print("DEBUG: B+Y track_idx=$track_idx track_time=$track_time do_previous=$do_previous do_restart=$do_restart\n") if $ENV{PIDAP_DEBUG};
            kill(9, -$play_id) if $play_id > 0;
         } elsif (-e qq#${RUN_DIR}/pidap.generated.previous_track#) {
            my $now = Time::HiRes::time();
            my $effective_pause = $total_pause_time + ($paused ? ($now - $pause_start) : 0);
            my $album_time = $play_start_offset + ($now - $start_time - $effective_pause);
            my $track_idx = 0;
            for my $i (0 .. $#$offsets) {
               last if $offsets->[$i] > $album_time;
               $track_idx = $i;
            }
            my $track_start = $offsets->[$track_idx];
            my $track_time = $album_time - $track_start;
            $do_restart = &resolve_previous_track($play_album, $play_start_offset, $album_time, $offsets, $current_ii, $albums_ref, $album_offsets_cache_ref);
            print("DEBUG: previous_track track_idx=$track_idx track_time=$track_time resume_offset=$resume_offset resume_album=$resume_album\n") if $ENV{PIDAP_DEBUG};
            kill(9, -$play_id);
         } elsif (-e qq#${RUN_DIR}/pidap.generated.previous# || -e qq#${RUN_DIR}/pidap.generated.restart#) {
            kill(9, -$play_id);
         }
      }
      last if $res > 0 || $res == -1;
      my $now = Time::HiRes::time();
      if ($track_blink_until && $now >= $track_blink_until) {
         &led_off();
         $track_blink_until = 0;
      }
      my $consumed = 0;
      if ($sel) {
         my @ready = $sel->can_read($POLL);
         for my $fh (@ready) {
            if (fileno($fh) == fileno($menu_out_fh)) {
               my $line = <$menu_out_fh>;
               if (defined $line) {
                  $consumed = 1;
                  chomp $line;
                  if ($line =~ /^album=(.+?)\toffset=([0-9.]+)/) {
                     $resume_album = $1;
                     $resume_offset = $2;
                     $do_menu_select = 1;
                     print("DEBUG: menu result album=$resume_album offset=$resume_offset\n") if $ENV{PIDAP_DEBUG};
                     kill(9, -$play_id) if $play_id > 0;
                  } elsif ($line =~ /^cancel=1/) {
                     # ignore
                  }
               }
            } elsif (fileno($fh) == fileno($pause_fh)) {
               my $line = <$pause_fh>;
               if (defined $line) {
                  chomp $line;
                  if ($line =~ /^pause=([01])/) {
                     $consumed = 1;
                     if ($1 && !$paused) {
                        $paused = 1;
                        $pause_start = Time::HiRes::time();
                     } elsif (!$1 && $paused) {
                        $paused = 0;
                        $total_pause_time += (Time::HiRes::time() - $pause_start);
                     }
                  }
               }
            }
         }
      }
      Time::HiRes::usleep($POLL * 1_000_000) unless $consumed;
   }

   # Catch a previous_track request that arrived after the play process died,
   # so pidap_buttons B+X / X+B does not accidentally fall through to next album.
   if (-e qq#${RUN_DIR}/pidap.generated.previous_track#) {
      my $now = Time::HiRes::time();
      my $effective_pause = $total_pause_time + ($paused ? ($now - $pause_start) : 0);
      my $album_time = $play_start_offset + ($now - $start_time - $effective_pause);
      $do_restart = &resolve_previous_track($play_album, $play_start_offset, $album_time, $offsets, $current_ii, $albums_ref, $album_offsets_cache_ref);
   }

   &led_off();
   return ($do_previous, $do_restart, $do_menu_select);
}

sub play_one_album {
   my ($play_album, $current_ii, $albums_ref, $volume_initialized_ref, $album_offsets_cache_ref, $sel, $menu_out_fh, $pause_fh) = @_;
   unlink(qq#${RUN_DIR}/pidap.generated.restart#) if -e qq#${RUN_DIR}/pidap.generated.restart#;
   my ($files, $durations, $offsets, $total);
   if (exists $album_offsets_cache_ref->{$play_album}) {
      ($files, $durations, $offsets, $total) = @{$album_offsets_cache_ref->{$play_album}};
   } else {
      ($files, $durations, $offsets, $total) = &get_album_offsets($play_album);
      $album_offsets_cache_ref->{$play_album} = [$files, $durations, $offsets, $total];
   }
   &led_flash();
   if (!$$volume_initialized_ref) {
      if (!&set_initial_volume) {
         &led_off;
         return q#next#;
      }
      $$volume_initialized_ref = 1;
   }
   my $play_start_offset = 0;
   if ($resume_album && $play_album eq $resume_album && $resume_offset > 0) {
      $play_start_offset = $resume_offset;
      $first_lp = 0;
   }
   my $play_id = &start_playback($play_album, $play_start_offset, $files, $durations);
   $resume_album = q{};
   $resume_offset = 0;
   unlink($resume_file) if -e $resume_file;
   &led_off();
   &write_play_pid($play_id);
   my $do_previous = 0;
   my $do_restart = 0;
   my $do_menu_select = 0;
   if ($play_id > 0) {
      ($do_previous, $do_restart, $do_menu_select) =
         &monitor_playback($play_id, $play_start_offset, $play_album, $offsets, $current_ii, $albums_ref, $album_offsets_cache_ref, $sel, $menu_out_fh, $pause_fh);
   }
   print("DEBUG: before return do_previous=$do_previous do_restart=$do_restart\n") if $ENV{PIDAP_DEBUG};
   return q#next# if $do_menu_select;
   if ($do_previous || -e qq#${RUN_DIR}/pidap.generated.previous#) {
      unlink(qq#${RUN_DIR}/pidap.generated.previous#) if -e qq#${RUN_DIR}/pidap.generated.previous#;
      return q#prev#;
   }
   if ($do_restart || -e qq#${RUN_DIR}/pidap.generated.restart#) {
      my $restart_offset = 0;
      if (-e qq#${RUN_DIR}/pidap.generated.restart#) {
         if (open(my $rf, q#<#, qq#${RUN_DIR}/pidap.generated.restart#)) {
            while (<$rf>) {
               chomp;
               $restart_offset = $1 if (/^offset=([0-9.]+)/);
            }
            close($rf);
         }
         unlink(qq#${RUN_DIR}/pidap.generated.restart#);
      }
      if ($restart_offset > 0) {
         $resume_album = $play_album;
         $resume_offset = $restart_offset;
      }
      return q#restart#;
   }
   return q#next#;
}

sub play_albums() {
 my (@albums) = @_;
 my $volume_initialized = 0;
 my %album_offsets_cache = ();
 my $menu_out_fh;
 sysopen($menu_out_fh, "$RUN_DIR/pidap.generated.menu_out", O_RDWR|O_NONBLOCK) or warn "cannot open menu_out FIFO: $!";
 my $pause_fh;
 my $pause_fifo = "$RUN_DIR/pidap.generated.pause";
 if (-e $pause_fifo && !-p $pause_fifo) {
     unlink($pause_fifo);
 }
 unless (-p $pause_fifo) {
     POSIX::mkfifo($pause_fifo, 0666) or warn "cannot create pause FIFO $pause_fifo: $!";
 }
 sysopen($pause_fh, $pause_fifo, O_RDWR|O_NONBLOCK) or warn "cannot open pause FIFO: $!";
 my $sel;
 if (defined $menu_out_fh && defined $pause_fh) {
     $sel = IO::Select->new($menu_out_fh, $pause_fh);
 }

 # Resume from the actual last-played album if we can find it in
 # the current playlist.  A stale place index (from an old playlist)
 # can otherwise land on the wrong album after a playlist change.
 my $resume_target = $resume_album;
 my $resume_off = $resume_offset;
 unless ($resume_target) {
    ($resume_target, $resume_off) = &read_current_album($current_album_file);
 }
 my $ii = $first_lp;
 if ($resume_target) {
    for my $i (0 .. $#albums) {
       if ($albums[$i] eq $resume_target) {
          $ii = $i;
          $resume_album = $resume_target;
          $resume_offset = $resume_off;
          print("Resuming from current album: $resume_target at index $ii\n");
          last;
       }
    }
 }
 $ii = 0 if $ii < 0 || $ii > $#albums;

 while ($ii <= $#albums) {
  if ($resume_album) {
   for my $i (0 .. $#albums) {
    if ($albums[$i] eq $resume_album) {
     $ii = $i;
     last;
    }
   }
  }
  print("Album Name($ii): $albums[$ii]\n");
  &write_place_file($place_file, $ii);
  my $action = &play_one_album($albums[$ii], $ii, \@albums, \$volume_initialized, \%album_offsets_cache, $sel, $menu_out_fh, $pause_fh);
  if ($action eq q#prev#) {
   if ($ii > 0) { $ii--; } else { $ii = $#albums; }
  } elsif ($action eq q#restart#) {
   # stay on same album; resume_album/resume_offset already set
  } else {
   $ii++;
  }
 }
 unlink($place_file) if -e $place_file;
 &led_off();
}


#
# Print command and system run it.
#
sub print_run() {
   ($cmd) = (@_);

   my $pid = fork;
   die "Failed to fork $!\n" unless defined $pid;

   #
   # Child process only.
   #
   if($pid == 0) {

      #
      # Put the play process and its descendants (sox, aplay, ...) into
      # their own process group.  This lets us kill the whole family with
      # one signal to the group id.
      #
      setpgrp $$, $$;

      #
      # Send sox play output to the TFT console.
      #
      open(STDOUT, '>', '/dev/tty1') or open(STDOUT, '>', '/dev/null')
          or die "Can't open stdout: $!\n";
      open(STDERR, '>&STDOUT') or die "Can't dup STDOUT to STDERR: $!\n";

      #
      # For play commands, pipe output through filter_output before it
      # reaches the console.
      #
      if ($cmd =~ /^play\b/) {
          my $filter = "$FindBin::Bin/filter_output";
          my $filter_pid = open(my $filter_fh, '|-', '/usr/bin/perl', $filter)
              or die "Can't start filter_output: $!\n";
          select((select($filter_fh), $| = 1)[0]);

          # Feed the first track path to filter_output so the TFT shows
          # the artist/album/track immediately, before sox prints anything.
          my $first_file;
          if ($cmd =~ /^play\s+"([^"]+)"/) {
              $first_file = $1;
          } elsif ($cmd =~ /^play\s+(\S+)/) {
              $first_file = $1;
          }
          print $filter_fh "$first_file:\n" if $first_file;

          open(my $play_fh, '-|', '/bin/sh', '-c', "$cmd 2>&1")
              or die "Can't start play: $!\n";

          while (<$play_fh>) {
              print $filter_fh $_;
          }
          close($play_fh);
          close($filter_fh);
          exit;
      }

      system($cmd);
      exit;
   }

   #
   # Main process, pass back new child PID
   #
   return $pid;
}


#
# LED control helpers.
#
sub led_write {
   my ($file, $val) = @_;
   return unless $file;
   open(my $fh, '>', $file) or return;
   print $fh $val;
   close($fh);
}

sub led_init {
   led_off();
}

sub led_flash {
   return unless $led_brightness;
   led_write($led_trigger, 'none') if $led_trigger;
   led_write($led_brightness, 1);
}

sub led_track_blink {
   return unless $led_brightness;
   led_write($led_trigger, 'none') if $led_trigger;
   led_write($led_brightness, 1);
}

sub led_off {
   return unless $led_brightness;
   led_write($led_trigger, 'none') if $led_trigger;
   led_write($led_brightness, 0);
}


#
# Randomize array order.
# Thanks to Perl.LiveJournal.com
# https://perl.livejournal.com/101830.html
#
sub rand_array {
   my @array = @_;
   my @rand;
   while (@array) {
      my $i = int(rand(@array));
      my $random_item = $array[$i];
      push @rand, $random_item;
      splice(@array, $i, 1);
   }
   return @rand;
}
