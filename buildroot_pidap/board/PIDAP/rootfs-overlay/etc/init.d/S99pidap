#!/bin/sh

DAEMON=/usr/lib/pidap/pidap
PIDFILE=/run/pidap/pidap.pid

case "$1" in
    start)
        export PIDAP_NO_SYSTEMD=1
        export PIDAP_INITIAL_VOLUME=40
        export PIDAP_RUN_DIR=/run/pidap
        export PIDAP_DATA_DIR=/var/lib/pidap
        export PIDAP_DEBUG=1
        mkdir -p "$PIDAP_RUN_DIR" "$PIDAP_DATA_DIR"
        rm -f "$PIDAP_RUN_DIR/pidap.debug"
        /sbin/start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -O "$PIDAP_RUN_DIR/pidap.debug"
        ;;
    stop)
        /sbin/start-stop-daemon -K -p "$PIDFILE" 2>/dev/null || true
        # Clean up any child processes that may still be running.
        killall -q pidap-menu pidap-buttons filter_output 2>/dev/null || true
        rm -f "$PIDFILE"
        ;;
    restart)
        $0 stop
        $0 start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        ;;
esac
exit $?
