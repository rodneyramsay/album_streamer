#!/bin/sh
#
# Map tty1 to the Pirate Audio ST7789 TFT (/dev/fb1).
# The display is brought up via the pirate-tft device tree overlay.
# To keep the console on HDMI instead, create /etc/disable-pirate-tft before boot.
#

case "$1" in
    start)
        if [ -e /etc/disable-pirate-tft ]; then
            echo "Pirate TFT disabled by /etc/disable-pirate-tft"
            exit 0
        fi

        # Give the panel time to probe and create /dev/fb1.
        for i in $(seq 1 20); do
            [ -e /dev/fb1 ] && break
            sleep 0.1
        done

        if [ -e /dev/fb1 ]; then
            # Hide the blinking cursor and the shell prompt
            printf '\033[?25l' > /dev/tty1
            echo "Pirate TFT ready on /dev/fb1"
        else
            echo "Warning: /dev/fb1 did not appear" >&2
            dmesg | grep -i -E 'mipi|dbi|panel|backlight|firmware' | tail -n 30 >&2
        fi
        ;;
    stop)
        ;;
    *)
        ;;
esac
