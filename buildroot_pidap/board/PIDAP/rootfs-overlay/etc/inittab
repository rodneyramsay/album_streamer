# /etc/inittab - Startup script for BusyBox init
# Mount proc first so rcS and other tools can use it
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -o remount,rw /

::sysinit:/etc/init.d/rcS

# Serial console only; keep tty1 clear for the splash screen
#tty1::respawn:/sbin/getty -L tty1 0 vt100
ttyAMA0::respawn:/sbin/getty -L ttyAMA0 115200 vt100

# Standard actions
::shutdown:/bin/sh -c '/etc/init.d/S99pidap stop; sync; umount /usr/local/Music 2>/dev/null || mount -o remount,ro /usr/local/Music 2>/dev/null; umount -a -r'
::restart:/sbin/init
