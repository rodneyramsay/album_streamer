#!/usr/bin/perl


use POSIX ":sys_wait_h";
use Getopt::Std;
use FindBin;
use Time::HiRes;

#
# Button handler asks pidap to skip to the next track via SIGUSR1,
# or asks for previous/restart via SIGUSR2 (B+Y).
#
our $g_skip_track = 0;
our $g_prev_or_restart = 0;
our $g_prev_or_restart_time = 0;
$SIG{USR1} = sub { $g_skip_track = 1; };
$SIG{USR2} = sub { $g_prev_or_restart = 1; $g_prev_or_restart_time = Time::HiRes::time(); };


$usage =
    "pidap [-B] [-P] [-c <category>] [-a <artist>] [-l <album>] [-m <mount>] [-p] [-q] [-r]\n" .
    "\n" .
    "  -B  build (playlist generator) mode: create playlist and exit\n" .
    "  -P  play-only mode: do not generate a new playlist\n" .
    "\n" .
    "<category>, <artist>, and <album> arguments can be perl regex or simple string\n" .
    "\n" .
    "Pirate Audio button mapping (default):\n\n" .
    "   A - Volume Up\n" .
    "   B - Volume Down\n" .
    "   X - Short press: Pause/Resume (resumes here on next boot if paused), hold 3s: Lock/Unlock\n" .
    "   Y - Next Track\n" .
    "   A + Y - Next Album\n" .
    "   B + Y - Restart Album (first track within 15s: Previous Album)\n" .
    "   A + B - Restart Track (within first 15s: Previous Track)\n" .
    "   (override with PIDAP_BUTTON_MAP env var)\n" .
    "\n\n";

getopts("a:Bc:hl:m:pPqr");

if(defined($opt_h)) {
   print $usage;
   exit;
}

if(defined($opt_m)) {
   $mount = $opt_m;
} else {
   $mount = "/usr/local/Music";
}

$playlist_file = "$FindBin::Bin/pidap.generated.playlist";
$place_file = "$FindBin::Bin/pidap.generated.place";

#
# Pirate Audio button / volume handler settings
#
$play_pid_file = "pidap.generated.play_pid";
$resume_file = "pidap.generated.resume";
$current_album_file = "pidap.generated.current_album";
$ENV{PIDAP_PID_FILE} = $play_pid_file;
$ENV{PIDAP_BUTTON_MAP} = $ENV{PIDAP_BUTTON_MAP} || "A:vol_up,B:vol_down,X:lock,Y:next_track";
$ENV{PIDAP_VOLUME_CONTROL} = $ENV{PIDAP_VOLUME_CONTROL} || "Amp";
$ENV{PIDAP_VOLUME_STEP} = $ENV{PIDAP_VOLUME_STEP} || "2";
$ENV{PIDAP_INITIAL_VOLUME} = $ENV{PIDAP_INITIAL_VOLUME} || "40";

my $build_only = $ENV{PIDAP_BUILD_PLAYLIST} ? 1 : (defined($opt_B) ? 1 : 0);
my $play_only  = $ENV{PIDAP_PLAY_ONLY} ? 1 : (defined($opt_P) ? 1 : 0);

#
# LED control. Default to the Pi's on-board ACT/led0 LED.
#
$led_brightness = $ENV{PIDAP_LED_PATH} || "";
$led_trigger    = $ENV{PIDAP_LED_TRIGGER} || "";
if(!$led_brightness && -w "/sys/class/leds/led0/brightness") {
   $led_brightness = "/sys/class/leds/led0/brightness";
} elsif(!$led_brightness && -w "/sys/class/leds/ACT/brightness") {
   $led_brightness = "/sys/class/leds/ACT/brightness";
}
if($led_brightness && !$led_trigger) {
   ($led_trigger = $led_brightness) =~ s{/brightness$}{/trigger};
}

unlink($play_pid_file) if(-e $play_pid_file);

my $boot_mode = $build_only ? &read_boot_gpio() : '';

unless ($build_only) {
    &start_gpio_handler();
    &led_init();
}


######################################################################
#
#
#
$run = 1;
$first_lp = 0;

my $resume_album = '';
my $resume_offset = 0;

@artists = ();
@categories = ();
@albums = ();

@play_artists = ();
@play_categories = ();
@play_albums = ();



#
# Directory structure organization:
#
#   Music/<Category>/<Artist>/<Album>/<Track>.flac
#
my $boot_applied = 0;

while($run) {

   if ($build_only) {
      my @usb_mounts = &mount_usb_devices();
      &link_usb_mounts(@usb_mounts);
   }

   print
("Building Album List");

   #
   # Check category directories
   #
   foreach $category (`ls $mount/`) {
      chomp($category);
      next unless -d "$mount/$category";

      #
      # List of all categories for manipulating play list later.
      #
      push(@categories, $category);

      #
      # List of categories to play now.
      #
      if(!defined($opt_c) || ($category =~ m/$opt_c/)) {
	 $play_categories{$category} = $category;
	 push(@play_categories, $category);
      }


      #
      # Check artist directories
      #
      foreach $artist (`ls $mount/$category/`) {
	 chomp($artist);
	 next unless -d "$mount/$category/$artist";

	 #
	 # List of all artists
	 #
	 push(@artists, $artist);

	 #
	 # If -a option only want to play artists matching name..
	 # List of artists to play now.
	 #
	 if(defined($play_categories{$category}) &&
	     (!defined($opt_a) || ($artist =~ m/$opt_a/))) {

	    $play_artists{$artist} = $artist;
	    push(@play_artists, $artist);
	 }


	 #
	 # Check album directories
	 #
	 foreach $album (`ls $mount/$category/$artist | sort`) {
	    print(".");

	    chomp($album);

	    #
	    # For multi-disk albums, only remember disc 1.
	    # Play multi-disk albums all together later...
	    #
	    if($album =~ m/dis[ck]_?(\d+)/i) {
	       $disk_num = $1;
	       next unless($disk_num =~ m/0*1/);
	    }

	    #
	    # All Album names
	    #
	    push(@album_names, $album);

	    $album_path = "${mount}/${category}/${artist}/${album}";
    next unless -d $album_path;

	    #
	    # Build lists of albums.
	    #
	    push(@{$albums{$category}}, $album_path);
	    push(@{$albums{$artist}}, $album_path);

	    #
	    # List of album full paths.
	    #
	    push(@albums, $album_path);

	    #	    $last_track = `ls $album_path | tail -1`;
	    #	    $last_track{$album_path} = "${mount}/${category}/${artist}/${album}/${last_track}";

	    #
	    # -l option only play matching albums.
	    #
	    if(defined($play_categories{$category}) && defined($play_artists{$artist})) {
	       if(!defined($opt_l) || ($album =~ m/$opt_l/)) {
		  my $play_path = "${mount}/${category}/${artist}/${album}";
	  my @tracks = glob("${play_path}*/*.flac");
	  next unless @tracks;
	  push(@play_albums, $play_path);
	       }
	    }
	 }
      }
   }

   #
   # Start streaming albums
   #
   print("\n\n======================== PIDAP! ================================\n\n");

   #
   # Use a saved playlist if it exists and no filters are in effect.
   # Filters change the album set, so we always build fresh for those.
   #
   my $using_filters = (defined($opt_c) || defined($opt_a) || defined($opt_l));
   my $loaded_playlist = 0;
   my @disk_albums = @play_albums;

   if (!$using_filters && -r $playlist_file) {
      my @saved = &read_playlist_file($playlist_file);
      if (@saved) {
         my %disk = map { $_ => 1 } @disk_albums;
         my @valid = grep { -d $_ && $disk{$_} } @saved;
         if (@valid) {
            @play_albums = @valid;
            $loaded_playlist = 1;
            print("Using saved playlist order\n");
         } else {
            print("Warning: saved playlist is out of date, rebuilding\n");
            unlink($playlist_file) if -e $playlist_file;
         }
      }
   }

   #
   # No saved playlist: build a fresh one, shuffle or sort it, and save it.
   # In play-only mode, do not generate the playlist here; that is the
   # playlist generator's job.
   #
   unless ($loaded_playlist) {
      if ($play_only) {
         print "No playlist file ($playlist_file) available, cannot play\n";
         exit(1);
      }

      if ($sorted_playlist) {
         @play_albums = sort @play_albums;
      } else {
         @play_albums = &rand_array(@play_albums);
      }

      if (!$using_filters) {
         if (open(my $cf, '>', $playlist_file)) {
            foreach $jj (0 .. $#play_albums) {
               printf($cf "CUESHEET:%7d %s\n", $jj, $play_albums[$jj]);
            }
            close($cf);
         } else {
            print "Warning: could not write $playlist_file: $!\n";
         }
         unlink($place_file) if -e $place_file;
      }
   }

   my $sorted_playlist = 0;

   #
   # Boot-time button actions.
   #
   if ($boot_mode && !$boot_applied) {
      $boot_applied = 1;
      if ($boot_mode eq 'A') {
         print "Boot: hold A - regenerate random playlist\n";
         unlink($playlist_file) if -e $playlist_file;
         unlink($place_file) if -e $place_file;
         unlink($resume_file) if -e $resume_file;
         $resume_album = '';
         $resume_offset = 0;
         $first_lp = 0;
      } elsif ($boot_mode eq 'B') {
         print "Boot: hold B - sorted playlist\n";
         $sorted_playlist = 1;
         unlink($playlist_file) if -e $playlist_file;
         unlink($place_file) if -e $place_file;
         unlink($resume_file) if -e $resume_file;
         $resume_album = '';
         $resume_offset = 0;
         $first_lp = 0;
      } elsif ($boot_mode eq 'X') {
         print "Boot: hold X - start from first track\n";
         unlink($place_file) if -e $place_file;
         unlink($resume_file) if -e $resume_file;
         $resume_album = '';
         $resume_offset = 0;
         $first_lp = 0;
      }
   }

   #
   # Restore resume position if paused before shutdown.
   #
   ($resume_album, $resume_offset) = &read_resume;
   if ($resume_album) {
      my $found = 0;
      for my $i (0 .. $#play_albums) {
         if ($play_albums[$i] eq $resume_album) {
            $first_lp = $i;
            $found = 1;
            last;
         }
      }
      unless ($found) {
         print "Warning: resume album $resume_album not in playlist, ignoring\n";
         $resume_album = '';
         $resume_offset = 0;
         unlink($resume_file) if -e $resume_file;
      }
   }

   #
   # Otherwise, restore our place in the playlist.
   #
   unless ($resume_album) {
      my $place = &read_place_file($place_file);
      if ($place > 0 && $place <= $#play_albums) {
         $first_lp = $place;
         print("Resuming playlist at index $first_lp: $play_albums[$first_lp]\n");
      } elsif ($place > $#play_albums && $place > 0) {
         print("Playlist was finished; starting over\n");
         unlink($place_file) if -e $place_file;
         $first_lp = 0;
      }
   }

   #
   # Print out cuesheet unless quiet mode.
   #
   unless(defined($opt_q)) {
      foreach $jj (0 .. $#play_albums) {
         printf("CUESHEET:%7d %s\n", $jj, $play_albums[$jj]);
      }
   }

   if ($build_only) {
      print "Playlist built ($#play_albums albums), exiting build-only mode\n";
      exit(0);
   }

   &play_albums(@play_albums);

   #
   # Loop back to the beginning when the playlist finishes.
   # If we were interrupted, the place file still exists and we
   # resume from there. Use -p to stop after one pass.
   #
   last if(defined($opt_p));
   if (-e $place_file) {
      next;
   }
   $first_lp = 0;
   next;
}


