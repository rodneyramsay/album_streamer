sub start_gpio_handler() {

   my $handler = "$FindBin::Bin/pidap_buttons.pl";

   unless(-r $handler) {
      print "Warning: $handler not found, button control disabled\n";
      return 0;
   }

   print "Forking GPIO button handler: $handler\n";

   my $pid = fork;
   die "Failed to fork GPIO handler\n" unless defined $pid;

   if($pid == 0) {
      exec("perl", $handler) or die "Failed to exec $handler: $!\n";
   }

   print "GPIO handler pid: $pid\n";
   return $pid;
}

sub is_gpio_low {
    my ($val) = @_;
    return 0 unless defined $val;
    return 1 if $val eq '0';
    return 1 if $val =~ /^(inactive|off|low)$/i;
    return 0;
}

sub read_boot_gpio() {

   my @cmd = ('gpioget', '-c', 'gpiochip0', '--bias=pull-up', 5, 6, 16, 24);
   print "Boot GPIO: running @cmd\n";
   my $out = `@cmd 2>/dev/null`;
   print "Boot GPIO (bias): $out\n" if defined $out;
   unless (defined $out && $out =~ /\S/) {
      my @plain = ('gpioget', '-c', 'gpiochip0', 5, 6, 16, 24);
      print "Boot GPIO: falling back to @plain\n";
      $out = `@plain 2>/dev/null`;
      print "Boot GPIO (plain): $out\n" if defined $out;
   }
   unless (defined $out && $out =~ /\S/) {
      print "Boot GPIO: no readable button state\n";
      return '';
   }

   my @pin_order = (5, 6, 16, 24);
   my @labels = ('A', 'B', 'X', 'Y');
   my %state = ();

   # libgpiod 2.x style: "5"=active "6"=inactive ...
   for my $tok (split /\s+/, $out) {
      if ($tok =~ /^"(\d+)"=(\S+)$/) {
         $state{$1} = $2;
      }
   }

   # Older style: one value per line (0/1) in pin order.
   unless (%state) {
      my @vals = split /\s+/, $out;
      for my $i (0 .. $#pin_order) {
         $state{$pin_order[$i]} = $vals[$i] if defined $vals[$i];
      }
   }

   for my $i (0 .. $#pin_order) {
      my $pin = $pin_order[$i];
      next unless exists $state{$pin};
      if (&is_gpio_low($state{$pin})) {
         print "Boot GPIO: button $labels[$i] held ($pin = $state{$pin})\n";
         return $labels[$i] if $labels[$i] =~ /^(A|B|X)$/;
      }
   }
   print "Boot GPIO: no A/B/X button held\n";
   return '';
}

sub find_usb_partitions {

   my @found = ();
   my $lsblk = `lsblk -P -o PATH,TYPE,TRAN,FSTYPE,MOUNTPOINT 2>/dev/null`;
   return @found unless defined $lsblk && $lsblk =~ /\S/;

   for my $line (split /\n/, $lsblk) {
      next unless $line =~ /\S/;
      my %f = ();
      while ($line =~ /(\w+)="([^"]*)"/g) {
         $f{$1} = $2;
      }
      next unless $f{TYPE} && $f{TYPE} eq 'part';
      next unless $f{FSTYPE} && $f{FSTYPE} =~ /^(vfat|exfat|ntfs|ext4|btrfs|auto|xfs)/i;
      next if $f{MOUNTPOINT} && $f{MOUNTPOINT} =~ /\S/;
      next unless ($f{TRAN} && $f{TRAN} eq 'usb') || ($f{RM} && $f{RM} eq '1');
      push @found, $f{PATH};
   }

   return @found;
}

sub mount_usb_devices {

   my @usb_mounts = ();
   my @parts = &find_usb_partitions();
   return @usb_mounts unless @parts;

   `mkdir -p /media` unless -d '/media';

   my $n = 1;
   for my $part (@parts) {
      my $dir = sprintf('/media/USB%02d', $n++);
      `mkdir -p "$dir"`;

      my $rc = system('mount', $part, $dir);
      if ($rc != 0) {
         my $fs = `blkid -s TYPE -o value "$part" 2>/dev/null`;
         chomp($fs) if $fs;
         $fs = 'auto' unless $fs;
         $rc = system('mount', '-t', $fs, $part, $dir);
      }

      if ($rc == 0) {
         push @usb_mounts, $dir;
         print "Mounted USB partition $part on $dir\n";
      } else {
         print "Warning: failed to mount $part\n";
         rmdir($dir) if -d $dir;
      }
   }

   my $mfile = "$FindBin::Bin/pidap.generated.usb_mounts";
   if (@usb_mounts) {
      if (open(my $uf, '>', $mfile)) {
         print $uf "$_\n" for @usb_mounts;
         close($uf);
      }
   } else {
      unlink($mfile) if -e $mfile;
   }

   return @usb_mounts;
}

sub link_usb_mounts {

   my (@usb_dirs) = @_;

   # Clean up stale USB symlinks under the main music mount.
   if (-d $mount) {
      for my $old (glob "$mount/USB*") {
         unlink($old) if -l $old;
      }
   }

   # Create new symlinks so pidap's normal scanner picks them up.
   my $n = 1;
   for my $dir (@usb_dirs) {
      my $name = sprintf('USB%02d', $n++);
      my $link = "$mount/$name";
      if (symlink($dir, $link)) {
         print "Linked $dir as $link\n";
      } else {
         print "Warning: failed to symlink $dir to $link: $!\n";
      }
   }
}


sub write_play_pid() {

   my ($pid) = (@_);

   return unless $pid;

   open(PIDF, ">$play_pid_file") or return;
   print PIDF "$pid\n";
   close(PIDF);
}


sub set_initial_volume {

   my $control = $ENV{PIDAP_VOLUME_CONTROL} || 'Amp';
   my $initial = $ENV{PIDAP_INITIAL_VOLUME} || 40;
   my $max = 20;
   my $attempt = 0;

   while($attempt < $max) {
      my $rc = system("amixer sset $control ${initial}% >/dev/null 2>&1");
      if($rc == 0) {
	 print("Initial volume set to ${initial}%\n");
	 return;
      }
      Time::HiRes::usleep(200_000);
      $attempt++;
   }

   print("Warning: could not set initial volume to ${initial}%\n");
}


sub read_resume {
   my ($album, $offset) = ('', 0);
   if (-r $resume_file) {
      if (open(my $rf, '<', $resume_file)) {
         while (<$rf>) {
            chomp;
            if (/^album=(.+)/) { $album = $1; }
            elsif (/^offset=([0-9.]+)/) { $offset = $1; }
         }
         close($rf);
      }
   }
   return ($album, $offset);
}

sub get_album_offsets {
   my ($album) = @_;
   my @files = sort glob("${album}*/*.flac");
   my @durations;
   my @offsets;
   my $cum = 0;
   for my $f (@files) {
      my $d = soxi_duration($f);
      push @durations, $d;
      push @offsets, $cum;
      $cum += $d;
   }
   return (\@files, \@durations, \@offsets, $cum);
}

sub write_current_album {
   my ($album, $start_offset, $files, $durations) = @_;
   return unless $album;
   $start_offset ||= 0;
   if (open(my $cf, '>', $current_album_file)) {
      print $cf "album=$album\noffset=$start_offset\n";
      if ($files && $durations && @$files) {
	 for my $i (0 .. $#$files) {
	    print $cf "track:$i:$durations->[$i]=$files->[$i]\n";
	 }
      }
      close($cf);
   } else {
      print "Warning: could not write $current_album_file: $!\n";
   }
}

sub read_current_album {
   my ($album, $offset) = ('', 0);
   if (-r $current_album_file && open(my $cf, '<', $current_album_file)) {
      while (<$cf>) {
         chomp;
         $album = $1 if /^album=(.+)/;
         $offset = $1 if /^offset=([0-9.]+)/;
      }
      close($cf);
   }
   return ($album, $offset);
}

sub soxi_duration {
   my ($file) = @_;
   my $out = `soxi -D "$file" 2>/dev/null`;
   return 0 unless defined $out && $out =~ /^([0-9.]+)/;
   return $1 + 0;
}

sub build_resume_cmd {
   my ($album, $offset, $files, $durations) = @_;
   return undef unless $files && @$files;

   my $cum = 0;
   my $idx = 0;
   my $track_offset = 0;
   for my $i (0 .. $#$files) {
      my $d = $durations->[$i];
      $cum += $d;
      if ($cum > $offset) {
         $idx = $i;
         $track_offset = $offset - ($cum - $d);
         last;
      }
   }
   my @remaining = @$files[$idx .. $#$files];
   my $cmd = 'play ' . join(' ', map { "\"$_\"" } @remaining);
   if ($track_offset > 0) {
      $cmd .= ' trim ' . sprintf('%.2f', $track_offset);
   }
   return $cmd;
}

sub read_playlist_file {
   my ($file) = @_;
   my @paths = ();
   if (open(my $pf, '<', $file)) {
      while (<$pf>) {
         chomp;
         next unless $_;
         if (m/^\s*(?:CUESHEET:\s*)?\d+\s+(.+)$/) {
            push @paths, $1;
         } elsif (m/^(.+)$/) {
            push @paths, $1;
         }
      }
      close($pf);
   }
   return @paths;
}

sub read_place_file {
   my ($file) = @_;
   return 0 unless -r $file;
   if (open(my $pf, '<', $file)) {
      my $line = <$pf>;
      close($pf);
      return 0 unless defined $line;
      chomp $line;
      return $1 if $line =~ /^(\d+)$/;
   }
   return 0;
}

sub write_place_file {
   my ($file, $index) = @_;
   if (open(my $pf, '>', $file)) {
      print $pf "$index\n";
      close($pf);
   } else {
      print "Warning: could not write $file: $!\n";
   }
}

sub find_play_child {
   my ($ppid) = @_;
   my $dh;
   return 0 unless opendir($dh, '/proc');
   while (my $pid = readdir($dh)) {
      next unless $pid =~ /^\d+$/;
      next if $pid == $$;
      my $ppid_in_status = 0;
      if (open(my $st, '<', "/proc/$pid/status")) {
         while (<$st>) {
            $ppid_in_status = $1 if /^PPid:\s*(\d+)/;
         }
         close($st);
      }
      next unless $ppid_in_status == $ppid;
      my $comm = '';
      if (open(my $c, '<', "/proc/$pid/comm")) {
         $comm = <$c>;
         chomp($comm) if defined($comm);
         close($c);
      }
      return $pid if $comm =~ /^(sox|play|aplay)$/;
      my $found = &find_play_child($pid);
      return $found if $found;
   }
   closedir($dh);
   return 0;
}

sub play_one_album {
 my ($play_album, $volume_initialized_ref, $album_offsets_cache_ref) = @_;
 if ($play_album =~ m/(dis(c|k)_?(\d+))/i) {
  my ($disc_name, $disc_num) = ($1, $3);
  $play_album =~ s/$disc_num//;
 }
 unlink(q#pidap.generated.restart#) if -e q#pidap.generated.restart#;
 my ($files, $durations, $offsets, $total);
 if (exists $album_offsets_cache_ref->{$play_album}) {
  ($files, $durations, $offsets, $total) = @{$album_offsets_cache_ref->{$play_album}};
 } else {
  ($files, $durations, $offsets, $total) = &get_album_offsets($play_album);
  $album_offsets_cache_ref->{$play_album} = [$files, $durations, $offsets, $total];
 }
 &led_flash();
 my $play_start_offset = 0;
 my $play_id = 0;
 if ($resume_album && $play_album eq $resume_album && $resume_offset > 0) {
  $play_start_offset = $resume_offset;
  &write_current_album($play_album, $resume_offset, $files, $durations);
  my $resume_cmd = &build_resume_cmd($play_album, $resume_offset, $files, $durations);
  if ($resume_cmd) {
   $play_id = &print_run($resume_cmd);
   $first_lp = 0;
  }
  $resume_album = q{};
  $resume_offset = 0;
  unlink($resume_file) if -e $resume_file;
 } else {
  &write_current_album($play_album, 0, $files, $durations);
  $play_id = &print_run(qq#play ${play_album}*/*.flac#);
 }
 &led_off();
 &write_play_pid($play_id);
 if (!$$volume_initialized_ref) {
  &set_initial_volume;
  $$volume_initialized_ref = 1;
 }
 my $do_previous = 0;
 my $do_restart = 0;
 if ($play_id > 0) {
  my $start_time = Time::HiRes::time();
  my $track_blink_until = 0;
  my $next_offset_idx = 0;
  for my $i (0 .. $#$offsets) {
   last if $offsets->[$i] > $play_start_offset + 0.05;
   $next_offset_idx = $i + 1;
  }
  if ($play_start_offset > 0.05) {
   for my $i (0 .. $#$offsets) {
    if (abs($offsets->[$i] - $play_start_offset) < 0.05) {
     &led_track_blink();
     $track_blink_until = $start_time + 0.15;
     last;
    }
   }
  }
  my $paused = 0;
  my $pause_start = 0;
  my $total_pause_time = 0.0;
  while ($play_id > 0) {
   my $res = waitpid($play_id, WNOHANG);
   if ($res == 0) {
    if ($g_skip_track) {
     $g_skip_track = 0;
     if ($next_offset_idx <= $#$offsets) {
      $resume_album = $play_album;
      $resume_offset = $offsets->[$next_offset_idx];
      $do_restart = 1;
      &led_track_blink();
      $track_blink_until = Time::HiRes::time() + 0.15;
     }
     kill(9, -$play_id) if $play_id > 0;
    } elsif ($g_prev_or_restart) {
     $g_prev_or_restart = 0;
     my $now = $g_prev_or_restart_time;
     my $effective_pause = $total_pause_time + ($paused ? ($now - $pause_start) : 0);
     my $album_time = $play_start_offset + ($now - $start_time - $effective_pause);
     my $track_idx = 0;
     for my $i (0 .. $#$offsets) {
      last if $offsets->[$i] > $album_time;
      $track_idx = $i;
     }
     my $track_start = $offsets->[$track_idx];
     my $track_time = $album_time - $track_start;
     if ($track_idx == 0 && $track_time <= 5) {
      $do_previous = 1;
     } else {
      $do_restart = 1;
      $resume_album = $play_album;
      $resume_offset = 0;
     }
     print("DEBUG: B+Y track_idx=$track_idx track_time=$track_time do_previous=$do_previous do_restart=$do_restart\n");
     kill(9, -$play_id) if $play_id > 0;
    } elsif (-e q#pidap.generated.previous_track#) {
     unlink(q#pidap.generated.previous_track#);
     my $now = Time::HiRes::time();
     my $effective_pause = $total_pause_time + ($paused ? ($now - $pause_start) : 0);
     my $album_time = $play_start_offset + ($now - $start_time - $effective_pause);
     my $track_idx = 0;
     for my $i (0 .. $#$offsets) {
      last if $offsets->[$i] > $album_time;
      $track_idx = $i;
     }
     if ($track_idx > 0) {
      $resume_offset = $offsets->[$track_idx - 1];
     } else {
      $resume_offset = 0;
     }
     $resume_album = $play_album;
     $do_restart = 1;
     print("DEBUG: previous_track track_idx=$track_idx resume_offset=$resume_offset\n");
     kill(9, -$play_id);
    } elsif (-e q#pidap.generated.previous# || -e q#pidap.generated.restart#) {
     kill(9, -$play_id);
    }
   }
   last if $res > 0 || $res == -1;
   my $now = Time::HiRes::time();
   my $play_state = q#0#;
   if (open(my $st, q#<#, qq#/proc/$play_id/status#)) {
    while (<$st>) {
     $play_state = $1 if /^State:\s*(\S)/;
    }
    close($st);
   }
   if ($play_state eq q#T# && !$paused) {
    $paused = 1;
    $pause_start = $now;
   } elsif ($play_state ne q#T# && $paused) {
    $paused = 0;
    $total_pause_time += ($now - $pause_start);
   }
   my $effective_pause = $total_pause_time + ($paused ? ($now - $pause_start) : 0);
   my $album_time = $play_start_offset + ($now - $start_time - $effective_pause);
   if ($track_blink_until && $now >= $track_blink_until) {
    &led_off();
    $track_blink_until = 0;
   }
   Time::HiRes::usleep(100_000);
  }
  &led_off();
 }
 print("DEBUG: before return do_previous=$do_previous do_restart=$do_restart\n");
 if ($do_previous || -e q#pidap.generated.previous#) {
  unlink(q#pidap.generated.previous#) if -e q#pidap.generated.previous#;
  return q#prev#;
 }
 if ($do_restart || -e q#pidap.generated.restart#) {
  my $restart_offset = 0;
  if (-e q#pidap.generated.restart#) {
   if (open(my $rf, q#<#, q#pidap.generated.restart#)) {
    while (<$rf>) {
     chomp;
     $restart_offset = $1 if (/^offset=([0-9.]+)/);
    }
    close($rf);
   }
   unlink(q#pidap.generated.restart#);
  }
  if ($do_restart || $restart_offset > 0) {
   $resume_album = $play_album;
   $resume_offset = $do_restart ? $resume_offset : $restart_offset;
  }
  return q#restart#;
 }
 return q#next#;
}

sub play_albums() {
 my (@albums) = @_;
 my $volume_initialized = 0;
 my %album_offsets_cache = ();

 # Resume from the actual last-played album if we can find it in
 # the current playlist.  A stale place index (from an old playlist)
 # can otherwise land on the wrong album after a playlist change.
 my $resume_target = $resume_album;
 my $resume_off = $resume_offset;
 unless ($resume_target) {
    ($resume_target, $resume_off) = &read_current_album;
 }
 my $ii = $first_lp;
 if ($resume_target) {
    for my $i (0 .. $#albums) {
       if ($albums[$i] eq $resume_target) {
          $ii = $i;
          $resume_album = $resume_target;
          $resume_offset = $resume_off;
          print("Resuming from current album: $resume_target at index $ii\n");
          last;
       }
    }
 }
 $ii = 0 if $ii < 0 || $ii > $#albums;

 while ($ii <= $#albums) {
  print("Album Name($ii): $albums[$ii]\n");
  &write_place_file($place_file, $ii);
  my $action = &play_one_album($albums[$ii], \$volume_initialized, \%album_offsets_cache);
  if ($action eq q#prev#) {
   if ($ii > 0) { $ii--; } else { $ii = $#albums; }
  } elsif ($action eq q#restart#) {
   # stay on same album
  } else {
   $ii++;
  }
 }
 unlink($place_file) if -e $place_file;
 &led_off();
}

#
# Update the TFT display with the current artist/album/track.
#
sub update_display {
    my ($album_number, $album_path, $track_file) = @_;
    return unless defined $album_number && $album_path && $track_file;

    my @parts = split(m{/}, $album_path);
    return if @parts < 2;
    my $album_name  = "$album_number : " . $parts[-1];
    my $artist_name = $parts[-2];

    my $track_name = $track_file;
    $track_name =~ s{^.*/}{};
    $track_name =~ s{\.(?:flac|mp3|ogg|m4a|wav)$}{}i;

    my $display = "$FindBin::Bin/pidap_display";
    return unless -x $display;

    my $pid = fork;
    return unless defined $pid;

    if ($pid == 0) {
        open(STDOUT, '>/dev/null') or die;
        open(STDERR, '>/dev/null') or die;
        exec($display, '-a', $artist_name, '-l', $album_name, '-t', $track_name);
        exit;
    }
}

#
# Print command and system run it.
#
sub print_run() {
   ($cmd) = (@_);

   #
   #
   #
   print("$cmd\n");

   my $pid = fork;
   die "Failed to fork $!\n" unless defined $pid;

   #
   # Child process only.
   #
   if($pid == 0) {

      #
      # Put the play process and its descendants (sox, aplay, ...) into
      # their own process group.  This lets us kill the whole family with
      # one signal to the group id.
      #
      setpgrp $$, $$;

      #
      # Send sox play output to the TFT console.
      #
      open(STDOUT, '>', '/dev/tty1') or die "Can't open /dev/tty1: $!\n";
      open(STDERR, '>&STDOUT') or die "Can't dup STDOUT to STDERR: $!\n";

      #
      # For play commands, pipe output through filter_output before it
      # reaches the console.
      #
      if ($cmd =~ /^play\b/) {
          my $filter = "$FindBin::Bin/filter_output";
          my $filter_pid = open(my $filter_fh, '|-', '/usr/bin/perl', $filter)
              or die "Can't start filter_output: $!\n";
          select((select($filter_fh), $| = 1)[0]);

          open(my $play_fh, '-|', '/bin/sh', '-c', "$cmd 2>&1")
              or die "Can't start play: $!\n";

          while (<$play_fh>) {
              print $filter_fh $_;
          }
          close($play_fh);
          close($filter_fh);
          exit;
      }

      system($cmd);
      exit;
   }

   #
   # Main process, pass back new child PID
   #
   return $pid;
}


#
# LED control helpers.
#
sub led_write {
   my ($file, $val) = @_;
   return unless $file;
   open(my $fh, '>', $file) or return;
   print $fh $val;
   close($fh);
}

sub led_init {
   led_off();
}

sub led_flash {
   return unless $led_brightness;
   led_write($led_brightness, 1);
}

sub led_track_blink {
   return unless $led_brightness;
   led_write($led_brightness, 1);
}

sub led_off {
   return unless $led_brightness;
   led_write($led_trigger, 'none') if $led_trigger;
   led_write($led_brightness, 0);
}


#
# Randomize array order.
# Thanks to Perl.LiveJournal.com
# https://perl.livejournal.com/101830.html
#
sub rand_array {
   my @array = @_;
   my @rand;
   while (@array) {
      my $i = int(rand(@array));
      my $random_item = $array[$i];
      push @rand, $random_item;
      splice(@array, $i, 1);
   }
   return @rand;
}
