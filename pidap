sub start_gpio_handler() {

   my $handler = "$FindBin::Bin/pidap_buttons.pl";

   unless(-r $handler) {
      print "Warning: $handler not found, button control disabled\n";
      return 0;
   }

   print "Forking GPIO button handler: $handler\n";

   my $pid = fork;
   die "Failed to fork GPIO handler\n" unless defined $pid;

   if($pid == 0) {
      exec("perl", $handler) or die "Failed to exec $handler: $!\n";
   }

   print "GPIO handler pid: $pid\n";
   return $pid;
}

sub is_gpio_low {
    my ($val) = @_;
    return 0 unless defined $val;
    return 1 if $val eq '0';
    return 1 if $val =~ /^(inactive|off|low)$/i;
    return 0;
}

sub read_boot_gpio() {

   my @cmd = ('gpioget', '-c', 'gpiochip0', '--bias=pull-up', 5, 6, 16, 24);
   print "Boot GPIO: running @cmd\n";
   my $out = `@cmd 2>/dev/null`;
   print "Boot GPIO (bias): $out\n" if defined $out;
   unless (defined $out && $out =~ /\S/) {
      my @plain = ('gpioget', '-c', 'gpiochip0', 5, 6, 16, 24);
      print "Boot GPIO: falling back to @plain\n";
      $out = `@plain 2>/dev/null`;
      print "Boot GPIO (plain): $out\n" if defined $out;
   }
   unless (defined $out && $out =~ /\S/) {
      print "Boot GPIO: no readable button state\n";
      return '';
   }

   my @pin_order = (5, 6, 16, 24);
   my @labels = ('A', 'B', 'X', 'Y');
   my %state = ();

   # libgpiod 2.x style: "5"=active "6"=inactive ...
   for my $tok (split /\s+/, $out) {
      if ($tok =~ /^"(\d+)"=(\S+)$/) {
         $state{$1} = $2;
      }
   }

   # Older style: one value per line (0/1) in pin order.
   unless (%state) {
      my @vals = split /\s+/, $out;
      for my $i (0 .. $#pin_order) {
         $state{$pin_order[$i]} = $vals[$i] if defined $vals[$i];
      }
   }

   for my $i (0 .. $#pin_order) {
      my $pin = $pin_order[$i];
      next unless exists $state{$pin};
      if (&is_gpio_low($state{$pin})) {
         print "Boot GPIO: button $labels[$i] held ($pin = $state{$pin})\n";
         return $labels[$i] if $labels[$i] =~ /^(A|B|X)$/;
      }
   }
   print "Boot GPIO: no A/B/X button held\n";
   return '';
}

sub find_usb_partitions {

   my @found = ();
   my $lsblk = `lsblk -P -o PATH,PKNAME,TYPE,TRAN,FSTYPE,MOUNTPOINT,RM,HOTPLUG,MODEL 2>/dev/null`;
   unless (defined $lsblk && $lsblk =~ /\S/) {
      print "find_usb_partitions: lsblk produced no output\n";
      return @found;
   }
   print "find_usb_partitions: lsblk output:\n$lsblk\n";

   # First pass: build a map of parent disk attributes (RM/HOTPLUG/TRAN).
   my %parent = ();
   for my $line (split /\n/, $lsblk) {
      next unless $line =~ /\S/;
      my %f = ();
      while ($line =~ /(\w+)="([^"]*)"/g) {
         $f{$1} = $2;
      }
      next unless $f{TYPE} && $f{TYPE} eq 'disk';
      my $name = $f{PATH};
      $name =~ s#^.*/##;
      $parent{$name} = \%f;
   }

   # Second pass: find candidate partitions.
   for my $line (split /\n/, $lsblk) {
      next unless $line =~ /\S/;
      my %f = ();
      while ($line =~ /(\w+)="([^"]*)"/g) {
         $f{$1} = $2;
      }
      next unless $f{TYPE} && $f{TYPE} eq 'part';

      # Accept an already-mounted USB if it lives under /media/USBxx.
      # Otherwise only consider partitions that are not mounted.
      my $already_mounted = ($f{MOUNTPOINT} && $f{MOUNTPOINT} =~ m#^/media/USB\d+$#);
      next if $f{MOUNTPOINT} && $f{MOUNTPOINT} =~ /\S/ && !$already_mounted;

      # Inherit removable/USB flags from the parent disk if the partition
      # itself doesn't have them.
      my $p = ($f{PKNAME} && exists $parent{$f{PKNAME}}) ? $parent{$f{PKNAME}} : \%f;
      my $is_removable = ($p->{RM} && $p->{RM} eq '1') || ($p->{HOTPLUG} && $p->{HOTPLUG} eq '1');
      my $is_usb = $p->{TRAN} && $p->{TRAN} =~ /^(usb|sata|ata)$/i;
      my $why = $is_removable ? 'removable' : ($is_usb ? 'usb/sata' : 'no');
      print "find_usb_partitions: $f{PATH} hotplug=$why\n";
      next unless $is_removable || $is_usb;

      my $fs = $f{FSTYPE};
      unless ($fs && $fs =~ /^(vfat|exfat|ntfs|ext4|btrfs|xfs|auto)/i) {
         $fs = `blkid -s TYPE -o value "$f{PATH}" 2>/dev/null`;
         chomp($fs) if $fs;
      }
      unless ($fs && $fs =~ /^(vfat|exfat|ntfs|ext4|btrfs|xfs)/i) {
         print "find_usb_partitions: $f{PATH} unsupported or unknown fs '$fs', skipping\n";
         next;
      }

      # Return the existing mount point if it's already in /media, else the
      # device path so we can mount it ourselves.
      my $root = $already_mounted ? $f{MOUNTPOINT} : $f{PATH};
      print "find_usb_partitions: $f{PATH} looks good (fs=$fs, using $root)\n";
      push @found, $root;
   }

   return @found;
}

sub mount_usb_devices {

   my @usb_mounts = ();
   my @parts = &find_usb_partitions();
   return @usb_mounts unless @parts;

   `mkdir -p /media` unless -d '/media';

   # Remove leftover empty USB mount directories from previous runs so we
   # don't accumulate /media/USB01, /media/USB02, ... every time the
   # playlist generator runs.
   for my $old (glob '/media/USB*') {
      next unless -d $old;
      # /proc/mounts lists all active mounts; this works even if mountpoint(1)
      # is not installed.
      my $in_mtab = `grep -F " $old " /proc/mounts 2>/dev/null`;
      next if $in_mtab =~ /\S/;
      if (rmdir($old)) {
         print "Removed stale mount dir $old\n";
      } else {
         print "Warning: could not rmdir $old: $!\n";
      }
   }

   my $n = 1;
   for my $part (@parts) {
      my $dir;
      if ($part =~ m#^/media/USB\d+$# && -d $part) {
         # Already mounted from a previous run (or manually).
         $dir = $part;
         print "Using existing USB mount $dir\n";
      } else {
         do {
            $dir = sprintf('/media/USB%02d', $n++);
         } while (-d $dir);
         `mkdir -p "$dir"`;

         my $rc = system('mount', $part, $dir);
         if ($rc != 0) {
            my $fs = `blkid -s TYPE -o value "$part" 2>/dev/null`;
            chomp($fs) if $fs;
            $fs = 'auto' unless $fs;
            $rc = system('mount', '-t', $fs, $part, $dir);
         }

         if ($rc != 0) {
            print "Warning: failed to mount $part\n";
            rmdir($dir) if -d $dir;
            next;
         }
         print "Mounted USB partition $part on $dir\n";
      }
      push @usb_mounts, $dir;
   }

   my $mfile = "$FindBin::Bin/pidap.generated.usb_mounts";
   if (@usb_mounts) {
      if (open(my $uf, '>', $mfile)) {
         print $uf "$_\n" for @usb_mounts;
         close($uf);
      }
   } else {
      unlink($mfile) if -e $mfile;
   }

   return @usb_mounts;
}

sub add_usb_music_roots {

   my (@usb_dirs) = @_;

   # Add each mounted USB's music tree as an extra root. If the USB has a
   # top-level Music directory, use it; otherwise use the mount point itself.
   for my $dir (@usb_dirs) {
      my $root = $dir;
      my $music_root = "$dir/Music";
      if (-d $music_root) {
         $root = $music_root;
         print "Using $music_root as music root for $dir\n";
      }
      push @mounts, $root;
      print "Added music root: $root\n";
   }
}


sub write_play_pid() {

   my ($pid) = (@_);

   return unless $pid;

   open(PIDF, ">$play_pid_file") or return;
   print PIDF "$pid\n";
   close(PIDF);
}


sub set_initial_volume {

   my $control = $ENV{PIDAP_VOLUME_CONTROL} || 'Amp';
   my $initial = $ENV{PIDAP_INITIAL_VOLUME} || 40;
   my $max = 20;
   my $attempt = 0;

   while($attempt < $max) {
      my $rc = system("amixer sset $control ${initial}% >/dev/null 2>&1");
      if($rc == 0) {
	 print("Initial volume set to ${initial}%\n");
	 return;
      }
      Time::HiRes::usleep(200_000);
      $attempt++;
   }

   print("Warning: could not set initial volume to ${initial}%\n");
}


sub read_resume {
   my ($album, $offset) = ('', 0);
   if (-r $resume_file) {
      if (open(my $rf, '<', $resume_file)) {
         while (<$rf>) {
            chomp;
            if (/^album=(.+)/) { $album = $1; }
            elsif (/^offset=([0-9.]+)/) { $offset = $1; }
         }
         close($rf);
      }
   }
   return ($album, $offset);
}

sub get_album_offsets {
   my ($album) = @_;
   my @files = sort glob("${album}*/*.flac");
   my @durations;
   my @offsets;
   my $cum = 0;
   for my $f (@files) {
      my $d = soxi_duration($f);
      push @durations, $d;
      push @offsets, $cum;
      $cum += $d;
   }
   return (\@files, \@durations, \@offsets, $cum);
}

sub write_current_album {
   my ($album, $start_offset, $files, $durations) = @_;
   return unless $album;
   $start_offset ||= 0;
   if (open(my $cf, '>', $current_album_file)) {
      print $cf "album=$album\noffset=$start_offset\n";
      if ($files && $durations && @$files) {
	 for my $i (0 .. $#$files) {
	    print $cf "track:$i:$durations->[$i]=$files->[$i]\n";
	 }
      }
      close($cf);
   } else {
      print "Warning: could not write $current_album_file: $!\n";
   }
}

sub read_current_album {
   my ($album, $offset) = ('', 0);
   if (-r $current_album_file && open(my $cf, '<', $current_album_file)) {
      while (<$cf>) {
         chomp;
         $album = $1 if /^album=(.+)/;
         $offset = $1 if /^offset=([0-9.]+)/;
      }
      close($cf);
   }
   return ($album, $offset);
}

sub soxi_duration {
   my ($file) = @_;
   my $out = `soxi -D "$file" 2>/dev/null`;
   return 0 unless defined $out && $out =~ /^([0-9.]+)/;
   return $1 + 0;
}

sub build_resume_cmd {
   my ($album, $offset, $files, $durations) = @_;
   return undef unless $files && @$files;

   my $cum = 0;
   my $idx = 0;
   my $track_offset = 0;
   for my $i (0 .. $#$files) {
      my $d = $durations->[$i];
      $cum += $d;
      if ($cum > $offset) {
         $idx = $i;
         $track_offset = $offset - ($cum - $d);
         last;
      }
   }
   my @remaining = @$files[$idx .. $#$files];
   my $cmd = 'play ' . join(' ', map { "\"$_\"" } @remaining);
   if ($track_offset > 0) {
      $cmd .= ' trim ' . sprintf('%.2f', $track_offset);
   }
   return $cmd;
}

sub read_playlist_file {
   my ($file) = @_;
   my @paths = ();
   if (open(my $pf, '<', $file)) {
      while (<$pf>) {
         chomp;
         next unless $_;
         if (m/^\s*(?:CUESHEET:\s*)?\d+\s+(.+)$/) {
            push @paths, $1;
         } elsif (m/^(.+)$/) {
            push @paths, $1;
         }
      }
      close($pf);
   }
   return @paths;
}

sub read_place_file {
   my ($file) = @_;
   return 0 unless -r $file;
   if (open(my $pf, '<', $file)) {
      my $line = <$pf>;
      close($pf);
      return 0 unless defined $line;
      chomp $line;
      return $1 if $line =~ /^(\d+)$/;
   }
   return 0;
}

sub write_place_file {
   my ($file, $index) = @_;
   if (open(my $pf, '>', $file)) {
      print $pf "$index\n";
      close($pf);
   } else {
      print "Warning: could not write $file: $!\n";
   }
}

sub find_play_child {
   my ($ppid) = @_;
   my $dh;
   return 0 unless opendir($dh, '/proc');
   while (my $pid = readdir($dh)) {
      next unless $pid =~ /^\d+$/;
      next if $pid == $$;
      my $ppid_in_status = 0;
      if (open(my $st, '<', "/proc/$pid/status")) {
         while (<$st>) {
            $ppid_in_status = $1 if /^PPid:\s*(\d+)/;
         }
         close($st);
      }
      next unless $ppid_in_status == $ppid;
      my $comm = '';
      if (open(my $c, '<', "/proc/$pid/comm")) {
         $comm = <$c>;
         chomp($comm) if defined($comm);
         close($c);
      }
      return $pid if $comm =~ /^(sox|play|aplay)$/;
      my $found = &find_play_child($pid);
      return $found if $found;
   }
   closedir($dh);
   return 0;
}

sub play_one_album {
 my ($play_album, $current_ii, $albums_ref, $volume_initialized_ref, $album_offsets_cache_ref) = @_;
 my @albums = @$albums_ref;
 unlink(q#pidap.generated.restart#) if -e q#pidap.generated.restart#;
 my ($files, $durations, $offsets, $total);
 if (exists $album_offsets_cache_ref->{$play_album}) {
  ($files, $durations, $offsets, $total) = @{$album_offsets_cache_ref->{$play_album}};
 } else {
  ($files, $durations, $offsets, $total) = &get_album_offsets($play_album);
  $album_offsets_cache_ref->{$play_album} = [$files, $durations, $offsets, $total];
 }
 &led_flash();
 my $play_start_offset = 0;
 my $play_id = 0;
 if ($resume_album && $play_album eq $resume_album && $resume_offset > 0) {
  $play_start_offset = $resume_offset;
  &write_current_album($play_album, $resume_offset, $files, $durations);
  my $resume_cmd = &build_resume_cmd($play_album, $resume_offset, $files, $durations);
  if ($resume_cmd) {
   $play_id = &print_run($resume_cmd);
   $first_lp = 0;
  }
 } else {
  &write_current_album($play_album, 0, $files, $durations);
  my $cmd = &build_resume_cmd($play_album, 0, $files, $durations);
  $play_id = &print_run($cmd) if $cmd;
 }
 $resume_album = q{};
 $resume_offset = 0;
 unlink($resume_file) if -e $resume_file;
 &led_off();
 &write_play_pid($play_id);
 if (!$$volume_initialized_ref) {
  &set_initial_volume;
  $$volume_initialized_ref = 1;
 }
 my $do_previous = 0;
 my $do_restart = 0;
 if ($play_id > 0) {
  my $start_time = Time::HiRes::time();
  my $track_blink_until = 0;
  my $next_offset_idx = 0;
  for my $i (0 .. $#$offsets) {
   last if $offsets->[$i] > $play_start_offset + 0.05;
   $next_offset_idx = $i + 1;
  }
  if ($play_start_offset > 0.05) {
   for my $i (0 .. $#$offsets) {
    if (abs($offsets->[$i] - $play_start_offset) < 0.05) {
     &led_track_blink();
     $track_blink_until = $start_time + 0.15;
     last;
    }
   }
  }
  my $paused = 0;
  my $pause_start = 0;
  my $total_pause_time = 0.0;
  while ($play_id > 0) {
   my $res = waitpid($play_id, WNOHANG);
   if ($res == 0) {
    if ($g_skip_track) {
     $g_skip_track = 0;
     if ($next_offset_idx <= $#$offsets) {
      $resume_album = $play_album;
      $resume_offset = $offsets->[$next_offset_idx];
      $do_restart = 1;
      &led_track_blink();
      $track_blink_until = Time::HiRes::time() + 0.15;
     }
     kill(9, -$play_id) if $play_id > 0;
    } elsif ($g_prev_or_restart) {
     $g_prev_or_restart = 0;
     my $now = $g_prev_or_restart_time;
     my $effective_pause = $total_pause_time + ($paused ? ($now - $pause_start) : 0);
     my $album_time = $play_start_offset + ($now - $start_time - $effective_pause);
     my $track_idx = 0;
     for my $i (0 .. $#$offsets) {
      last if $offsets->[$i] > $album_time;
      $track_idx = $i;
     }
     my $track_start = $offsets->[$track_idx];
     my $track_time = $album_time - $track_start;
     if ($track_idx == 0 && $track_time <= 5) {
      $do_previous = 1;
     } else {
      $do_restart = 1;
      $resume_album = $play_album;
      $resume_offset = 0;
     }
     print("DEBUG: B+Y track_idx=$track_idx track_time=$track_time do_previous=$do_previous do_restart=$do_restart\n");
     kill(9, -$play_id) if $play_id > 0;
    } elsif (-e q#pidap.generated.previous_track#) {
     unlink(q#pidap.generated.previous_track#);
     my $now = Time::HiRes::time();
     my $effective_pause = $total_pause_time + ($paused ? ($now - $pause_start) : 0);
     my $album_time = $play_start_offset + ($now - $start_time - $effective_pause);
     my $track_idx = 0;
     for my $i (0 .. $#$offsets) {
      last if $offsets->[$i] > $album_time;
      $track_idx = $i;
     }
     if ($track_idx > 0) {
      $resume_offset = $offsets->[$track_idx - 1];
     } else {
      $resume_offset = 0;
     }
     $resume_album = $play_album;
     $do_restart = 1;
     print("DEBUG: previous_track track_idx=$track_idx resume_offset=$resume_offset\n");
     kill(9, -$play_id);
    } elsif (-e q#pidap.generated.menu#) {
     unlink(q#pidap.generated.menu#);
     # Find the currently playing track start so we know if the user picked something different.
     my $track_idx = 0;
     for my $i (0 .. $#$offsets) {
        last if $offsets->[$i] > $album_time;
        $track_idx = $i;
     }
     my $track_start = $offsets->[$track_idx] || 0;
     &run_menu($albums_ref, $current_ii);
     if ($resume_album && ($resume_album ne $play_album || $resume_offset != $track_start)) {
        $do_restart = 1;
        kill(9, -$play_id) if $play_id > 0;
     }
    } elsif (-e q#pidap.generated.previous# || -e q#pidap.generated.restart#) {
     kill(9, -$play_id);
    }
   }
   last if $res > 0 || $res == -1;
   my $now = Time::HiRes::time();
   my $play_state = q#0#;
   if (open(my $st, q#<#, qq#/proc/$play_id/status#)) {
    while (<$st>) {
     $play_state = $1 if /^State:\s*(\S)/;
    }
    close($st);
   }
   if ($play_state eq q#T# && !$paused) {
    $paused = 1;
    $pause_start = $now;
   } elsif ($play_state ne q#T# && $paused) {
    $paused = 0;
    $total_pause_time += ($now - $pause_start);
   }
   my $effective_pause = $total_pause_time + ($paused ? ($now - $pause_start) : 0);
   my $album_time = $play_start_offset + ($now - $start_time - $effective_pause);
   if ($track_blink_until && $now >= $track_blink_until) {
    &led_off();
    $track_blink_until = 0;
   }
   Time::HiRes::usleep(100_000);
  }

  # Catch a previous_track request that arrived after the play process died,
  # so pidap_buttons B+X / X+B does not accidentally fall through to next album.
  if (-e q#pidap.generated.previous_track#) {
     unlink(q#pidap.generated.previous_track#);
     my $now = Time::HiRes::time();
     my $effective_pause = $total_pause_time + ($paused ? ($now - $pause_start) : 0);
     my $album_time = $play_start_offset + ($now - $start_time - $effective_pause);
     my $track_idx = 0;
     for my $i (0 .. $#$offsets) {
        last if $offsets->[$i] > $album_time;
        $track_idx = $i;
     }
     $resume_offset = 0;
     $resume_offset = $offsets->[$track_idx - 1] if $track_idx > 0;
     $resume_album = $play_album;
     $do_restart = 1;
  }

  &led_off();
 }
 print("DEBUG: before return do_previous=$do_previous do_restart=$do_restart\n");
 if ($do_previous || -e q#pidap.generated.previous#) {
  unlink(q#pidap.generated.previous#) if -e q#pidap.generated.previous#;
  return q#prev#;
 }
 if ($do_restart || -e q#pidap.generated.restart#) {
  my $restart_offset = 0;
  if (-e q#pidap.generated.restart#) {
   if (open(my $rf, q#<#, q#pidap.generated.restart#)) {
    while (<$rf>) {
     chomp;
     $restart_offset = $1 if (/^offset=([0-9.]+)/);
    }
    close($rf);
   }
   unlink(q#pidap.generated.restart#);
  }
  if ($restart_offset > 0) {
   $resume_album = $play_album;
   $resume_offset = $restart_offset;
  }
  return q#restart#;
 }
 return q#next#;
}

sub play_albums() {
 my (@albums) = @_;
 my $volume_initialized = 0;
 my %album_offsets_cache = ();

 # Resume from the actual last-played album if we can find it in
 # the current playlist.  A stale place index (from an old playlist)
 # can otherwise land on the wrong album after a playlist change.
 my $resume_target = $resume_album;
 my $resume_off = $resume_offset;
 unless ($resume_target) {
    ($resume_target, $resume_off) = &read_current_album;
 }
 my $ii = $first_lp;
 if ($resume_target) {
    for my $i (0 .. $#albums) {
       if ($albums[$i] eq $resume_target) {
          $ii = $i;
          $resume_album = $resume_target;
          $resume_offset = $resume_off;
          print("Resuming from current album: $resume_target at index $ii\n");
          last;
       }
    }
 }
 $ii = 0 if $ii < 0 || $ii > $#albums;

 while ($ii <= $#albums) {
  if ($resume_album) {
   for my $i (0 .. $#albums) {
    if ($albums[$i] eq $resume_album) {
     $ii = $i;
     last;
    }
   }
  }
  print("Album Name($ii): $albums[$ii]\n");
  &write_place_file($place_file, $ii);
  my $action = &play_one_album($albums[$ii], $ii, \@albums, \$volume_initialized, \%album_offsets_cache);
  if ($action eq q#prev#) {
   if ($ii > 0) { $ii--; } else { $ii = $#albums; }
  } elsif ($action eq q#restart#) {
   # stay on same album; resume_album/resume_offset already set
  } else {
   $ii++;
  }
 }
 unlink($place_file) if -e $place_file;
 &led_off();
}

#
# Update the TFT display with the current artist/album/track.
#
sub update_display {
    my ($album_number, $album_path, $track_file, $album_count) = @_;
    return unless defined $album_number && $album_path && $track_file;

    my @parts = split(m{/}, $album_path);
    return if @parts < 2;
    my $album_name = $parts[-1];
    my $artist_name = $parts[-2];

    my $track_name = $track_file;
    $track_name =~ s{^.*/}{};
    $track_name =~ s{\.(?:flac|mp3|ogg|m4a|wav)$}{}i;

    my $display = "$FindBin::Bin/pidap_display";
    if (-x $display) {
        my $display_name = "$album_number : $album_name";
        my $pid = fork;
        return unless defined $pid;
        if ($pid == 0) {
            open(STDOUT, '>/dev/null') or die;
            open(STDERR, '>/dev/null') or die;
            exec($display, '-a', $artist_name, '-l', $display_name, '-t', $track_name);
            exit;
        }
        return;
    }

    if (open(my $fh, '>', '/dev/tty1')) {
        my $count_str = (defined $album_count && $album_count > 0) ? "/$album_count" : '';
        print $fh "\e[2J\e[H";
        print $fh "\n$artist_name\n";
        print $fh "$album_number$count_str: $album_name\n";
        print $fh "$track_name\n";
        close($fh);
    }
}

#
# Print command and system run it.
#
sub print_run() {
   ($cmd) = (@_);

   #
   #
   #
   print("$cmd\n");

   my $pid = fork;
   die "Failed to fork $!\n" unless defined $pid;

   #
   # Child process only.
   #
   if($pid == 0) {

      #
      # Put the play process and its descendants (sox, aplay, ...) into
      # their own process group.  This lets us kill the whole family with
      # one signal to the group id.
      #
      setpgrp $$, $$;

      #
      # Send sox play output to the TFT console.
      #
      open(STDOUT, '>', '/dev/tty1') or die "Can't open /dev/tty1: $!\n";
      open(STDERR, '>&STDOUT') or die "Can't dup STDOUT to STDERR: $!\n";

      #
      # For play commands, pipe output through filter_output before it
      # reaches the console.
      #
      if ($cmd =~ /^play\b/) {
          my $filter = "$FindBin::Bin/filter_output";
          my $filter_pid = open(my $filter_fh, '|-', '/usr/bin/perl', $filter)
              or die "Can't start filter_output: $!\n";
          select((select($filter_fh), $| = 1)[0]);

          # Feed the first track path to filter_output so the TFT shows
          # the artist/album/track immediately, before sox prints anything.
          my $first_file;
          if ($cmd =~ /^play\s+"([^"]+)"/) {
              $first_file = $1;
          } elsif ($cmd =~ /^play\s+(\S+)/) {
              $first_file = $1;
          }
          print $filter_fh "$first_file:\n" if $first_file;

          open(my $play_fh, '-|', '/bin/sh', '-c', "$cmd 2>&1")
              or die "Can't start play: $!\n";

          while (<$play_fh>) {
              print $filter_fh $_;
          }
          close($play_fh);
          close($filter_fh);
          exit;
      }

      system($cmd);
      exit;
   }

   #
   # Main process, pass back new child PID
   #
   return $pid;
}


#
# LED control helpers.
#
sub led_write {
   my ($file, $val) = @_;
   return unless $file;
   open(my $fh, '>', $file) or return;
   print $fh $val;
   close($fh);
}

sub led_init {
   led_off();
}

sub led_flash {
   return unless $led_brightness;
   led_write($led_brightness, 1);
}

sub led_track_blink {
   return unless $led_brightness;
   led_write($led_brightness, 1);
}

sub led_off {
   return unless $led_brightness;
   led_write($led_trigger, 'none') if $led_trigger;
   led_write($led_brightness, 0);
}


#
# Show a multi-level menu: track -> album -> artist.
#
sub run_menu {
   my ($albums_ref, $current_album_idx) = @_;

   my @albums = @$albums_ref;
   $current_album_idx = 0 if $current_album_idx < 0 || $current_album_idx > $#albums;

   my ($current_album, $current_offset) = &read_current_album;
   $current_offset ||= 0;

   # Group albums by parent directory (artist).
   my %artist_paths;
   my %artist_albums;
   for my $i (0 .. $#albums) {
      my $p = $albums[$i];
      my $parent = ($p =~ m{^(.*)/[^/]+$}) ? $1 : '';
      $artist_paths{$parent} = 1 if $parent;
      push @{$artist_albums{$parent}}, $i;
   }
   my @artists = sort { (my $aa = $a) =~ s{^.*/}{}; (my $bb = $b) =~ s{^.*/}{}; $aa cmp $bb } keys %artist_paths;
   my %artist_to_idx;
   for my $i (0 .. $#artists) {
      $artist_to_idx{$artists[$i]} = $i;
   }
   for my $artist (keys %artist_albums) {
      $artist_albums{$artist} = [ sort { my $aa = $albums[$a]; $aa =~ s{^.*/}{}; my $bb = $albums[$b]; $bb =~ s{^.*/}{}; $aa cmp $bb } @{$artist_albums{$artist}} ];
   }
   my @artist_album_lists = map { $artist_albums{$_} } @artists;

   # Group artists by parent directory (genre).
   my %genre_paths;
   my %genre_artists;
   for my $artist (@artists) {
      my $parent = ($artist =~ m{^(.*)/[^/]+$}) ? $1 : '';
      $genre_paths{$parent} = 1 if $parent;
      push @{$genre_artists{$parent}}, $artist;
   }
   my @genres = sort { (my $aa = $a) =~ s{^.*/}{}; (my $bb = $b) =~ s{^.*/}{}; $aa cmp $bb } keys %genre_paths;
   for my $genre (keys %genre_artists) {
      $genre_artists{$genre} = [ sort { (my $aa = $a) =~ s{^.*/}{}; (my $bb = $b) =~ s{^.*/}{}; $aa cmp $bb } @{$genre_artists{$genre}} ];
   }
   my @genre_artist_lists = map { $genre_artists{$_} } @genres;

   # Find current genre, artist, album-within-artist, and track positions.
   my $current_genre_idx = 0;
   my $current_artist_in_genre_idx = 0;
   my $current_artist_idx = 0;
   my $current_album_in_artist_idx = 0;
   for my $gi (0 .. $#genres) {
      my $artists_for = $genre_artist_lists[$gi];
      for my $j (0 .. $#$artists_for) {
         my $ai = $artist_to_idx{$artists_for->[$j]};
         my $albums_for = $artist_album_lists[$ai];
         for my $k (0 .. $#$albums_for) {
            if ($albums_for->[$k] == $current_album_idx) {
               $current_genre_idx = $gi;
               $current_artist_in_genre_idx = $j;
               $current_artist_idx = $ai;
               $current_album_in_artist_idx = $k;
               last;
            }
         }
      }
   }

   my ($track_files, $track_durations, $track_offsets);
   my $current_track_idx = 0;
   ($track_files, $track_durations, $track_offsets) = &get_album_offsets($albums[$current_album_idx]);
   if ($track_durations && @$track_durations) {
      my $cum = 0;
      for my $i (0 .. $#$track_durations) {
         $cum += $track_durations->[$i];
         if ($cum > $current_offset) {
            $current_track_idx = $i;
            last;
         }
      }
   }
   my $current_track_file = $track_files->[$current_track_idx] // '';

   my $genre_idx = $current_genre_idx;
   my $artist_in_genre_idx = $current_artist_in_genre_idx;
   my $artist_idx = $current_artist_idx;
   my $album_in_artist_idx = $current_album_in_artist_idx;
   my $album_idx = $current_album_idx;
   my $track_album_idx = $album_idx;
   my $level = 3;          # 0 = genre, 1 = artist, 2 = album, 3 = track
   my $selected = $current_track_idx;
   my @items;
   my $title = '';
   my $did_select = 0;

   my $action;
   my $wait;
   while (1) {
      if ($level == 0) {
         @items = map { my $p = $_; $p =~ s{^.*/}{}; $p; } @genres;
         $title = '';
      } elsif ($level == 1) {
         my $artists_for = $genre_artist_lists[$genre_idx];
         @items = map { my $p = $_; $p =~ s{^.*/}{}; $p; } @$artists_for;
         $title = $genres[$genre_idx];
         $title =~ s{^.*/}{};
      } elsif ($level == 2) {
         my $albums_for = $artist_album_lists[$artist_idx];
         @items = map { my $p = $albums[$_]; $p =~ s{^.*/}{}; $p; } @$albums_for;
         $title = $artists[$artist_idx];
         $title =~ s{^.*/}{};
      } else {
         if ($track_album_idx != $album_idx) {
            my $album = $albums[$album_idx];
            ($track_files, $track_durations, $track_offsets) = &get_album_offsets($album);
            $track_album_idx = $album_idx;
         }
         unless ($track_files && @$track_files) {
            $level = 2;
            $selected = $album_in_artist_idx;
            next;
         }
         @items = map { my $f = $_; $f =~ s{^.*/}{}; $f; } @$track_files;
         $title = $albums[$album_idx];
         $title =~ s{^.*/}{};
      }

      &display_menu_list($title, \@items, $selected, 13);

      $action = '';
      $wait = 0;
      while (!$action && $wait < 100) {
         if (-r 'pidap.generated.menu_action') {
            if (open(my $af, '<', 'pidap.generated.menu_action')) {
               $action = <$af>;
               chomp $action if defined $action;
               close($af);
            }
            unlink('pidap.generated.menu_action');
         }
         $action = '' if defined $action && $action =~ /^\s*$/;
         last if ($action && $action =~ /^(up|down|select|back)$/);
         if (!-e 'pidap.generated.menu_mode') {
            $action = '';
            last;
         }
         $wait++;
         Time::HiRes::usleep(100_000);
      }

      if (!$action) {
         last;
      } elsif ($action eq 'back') {
         if ($level > 0) {
            $level--;
            if ($level == 2) {
               $selected = $album_in_artist_idx;
            } elsif ($level == 1) {
               $selected = $artist_in_genre_idx;
            } elsif ($level == 0) {
               $selected = $genre_idx;
            }
            next;
         }
         last;
      } elsif ($action eq 'up') {
         $selected-- if $selected > 0;
      } elsif ($action eq 'down') {
         $selected++ if $selected < $#items;
      } elsif ($action eq 'select') {
         if ($level == 0) {
            $genre_idx = $selected;
            $level = 1;
            $artist_in_genre_idx = ($genre_idx == $current_genre_idx) ? $current_artist_in_genre_idx : 0;
            $selected = $artist_in_genre_idx;
         } elsif ($level == 1) {
            $artist_in_genre_idx = $selected;
            $artist_idx = $artist_to_idx{$genre_artist_lists[$genre_idx][$selected]};
            $level = 2;
            $album_in_artist_idx = ($artist_idx == $current_artist_idx) ? $current_album_in_artist_idx : 0;
            $selected = $album_in_artist_idx;
         } elsif ($level == 2) {
            $album_in_artist_idx = $selected;
            $album_idx = $artist_album_lists[$artist_idx][$selected];
            $level = 3;
            if ($albums[$album_idx] eq $current_album) {
               $selected = $current_track_idx;
            } else {
               $selected = 0;
            }
         } else {
            $resume_album = $albums[$album_idx];
            $resume_offset = $track_offsets->[$selected] || 0;
            $did_select = 1;
            last;
         }
      }
   }

   if ($did_select) {
      $resume_album = $albums[$album_idx];
      $resume_offset = $track_offsets->[$selected] || 0;
   } else {
      $resume_album = q{};
      $resume_offset = 0;
   }

   &display_menu_list('', [], 0, 10);

   my $restore_album_path = $did_select ? $resume_album : $current_album;
   my $restore_track_file = $did_select ? ($track_files->[$selected] // '') : $current_track_file;
   my $restore_album_num = -1;
   for my $i (0 .. $#albums) {
      if ($albums[$i] eq $restore_album_path) {
         $restore_album_num = $i + 1;
         last;
      }
   }
   &update_display($restore_album_num, $restore_album_path, $restore_track_file, scalar(@albums));

   unlink('pidap.generated.menu_action') if -e 'pidap.generated.menu_action';
   unlink('pidap.generated.menu_mode') if -e 'pidap.generated.menu_mode';
}

#
# Display a scrollable menu list to the TFT console.
#
sub display_menu_list {
   my ($title, $items_ref, $selected, $visible_lines) = @_;
   $visible_lines ||= 10;
   $selected = 0 if $selected < 0;
   $selected = $#$items_ref if $selected > $#$items_ref;

   my $total = scalar(@$items_ref);
   my $item_lines = $visible_lines - ($title ? 1 : 0);
   $item_lines = 1 if $item_lines < 1;

   my $center_line = 7;
   my $center_pos = $center_line - ($title ? 2 : 1);
   $center_pos = 0 if $center_pos < 0;
   $center_pos = $item_lines - 1 if $center_pos >= $item_lines;

   my $top = 0;
   if ($total > $item_lines) {
      $top = $selected - $center_pos;
      $top = 0 if $top < 0;
      $top = $total - $item_lines if $top > $total - $item_lines;
   }

   my $max_columns = 24;
   my $title_max = $max_columns;
   my $item_max = $max_columns - 1;

   if (open(my $fh, '>', '/dev/tty1')) {
      # Only fully clear for the blank-out call; otherwise home and overwrite.
      if (!$title && $total == 0) {
         print $fh "\e[2J\e[H";
      } else {
         print $fh "\e[H";
      }
      if ($title) {
         my $t = (length($title) > $title_max) ? substr($title, 0, $title_max) : $title;
         printf $fh "\e[32m%-*s\e[0m\n", $title_max, $t;
      }
      my $end = $top + $item_lines - 1;
      for my $i ($top .. $end) {
         my $item = ($i <= $#$items_ref) ? $items_ref->[$i] : '';
         $item = substr($item, 0, $item_max) if length($item) > $item_max;
         if ($i == $selected) {
            printf $fh "\e[1m>%-*s\e[0m\n", $item_max, $item;
         } else {
            printf $fh " %-*s\n", $item_max, $item;
         }
      }
      close($fh);
   } else {
      print "Warning: cannot write to /dev/tty1: $!\n";
   }
}

#
# Randomize array order.
# Thanks to Perl.LiveJournal.com
# https://perl.livejournal.com/101830.html
#
sub rand_array {
   my @array = @_;
   my @rand;
   while (@array) {
      my $i = int(rand(@array));
      my $random_item = $array[$i];
      push @rand, $random_item;
      splice(@array, $i, 1);
   }
   return @rand;
}
