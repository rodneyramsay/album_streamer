#!/usr/bin/perl


use POSIX ":sys_wait_h";
use Getopt::Std;
use FindBin;
use Time::HiRes;


$usage =
    "pidap [-c <category>] [-a <artist>] [-l <album>] [-m <mount>] [-p] [-q]\n" .
    "\n" .
    "<category>, <artist>, and <album> arguments can be perl regex or simple string\n" .
    "\n" .
    "Pirate Audio button mapping (default):\n\n" .
    "   A - Volume Up\n" .
    "   B - Volume Down\n" .
    "   X - Short press: Pause/Resume (resumes here on next boot if paused), hold 3s: Lock/Unlock\n" .
    "   Y - Next Track\n" .
    "   A + Y - Next Album\n" .
    "   B + Y - Restart Album (first track within 15s: Previous Album)\n" .
    "   A + B - Restart Track (within first 15s: Previous Track)\n" .
    "   (override with PIDAP_BUTTON_MAP env var)\n" .
    "\n\n";

getopts("a:c:hl:m:pqr");

if(defined($opt_h)) {
   print $usage;
   exit;
}

if(defined($opt_m)) {
   $mount = $opt_m;
} else {
   $mount = "/usr/local/Music";
}

$playlist_file = "$mount/pidap.generated.playlist";
$place_file = "$mount/pidap.generated.place";

#
# Pirate Audio button / volume handler settings
#
$play_pid_file = "pidap.generated.play_pid";
$resume_file = "pidap.generated.resume";
$current_album_file = "pidap.generated.current_album";
$ENV{PIDAP_PID_FILE} = $play_pid_file;
$ENV{PIDAP_BUTTON_MAP} = $ENV{PIDAP_BUTTON_MAP} || "A:vol_up,B:vol_down,X:lock,Y:next_track";
$ENV{PIDAP_VOLUME_CONTROL} = $ENV{PIDAP_VOLUME_CONTROL} || "Amp";
$ENV{PIDAP_VOLUME_STEP} = $ENV{PIDAP_VOLUME_STEP} || "2";
$ENV{PIDAP_INITIAL_VOLUME} = $ENV{PIDAP_INITIAL_VOLUME} || "40";

#
# LED control. Default to the Pi's on-board ACT/led0 LED.
#
$led_brightness = $ENV{PIDAP_LED_PATH} || "";
$led_trigger    = $ENV{PIDAP_LED_TRIGGER} || "";
if(!$led_brightness && -w "/sys/class/leds/led0/brightness") {
   $led_brightness = "/sys/class/leds/led0/brightness";
} elsif(!$led_brightness && -w "/sys/class/leds/ACT/brightness") {
   $led_brightness = "/sys/class/leds/ACT/brightness";
}
if($led_brightness && !$led_trigger) {
   ($led_trigger = $led_brightness) =~ s{/brightness$}{/trigger};
}

unlink($play_pid_file) if(-e $play_pid_file);
&start_gpio_handler();
&led_init();


######################################################################
#
#
#
$run = 1;
$first_lp = 0;

my $resume_album = '';
my $resume_offset = 0;

@artists = ();
@categories = ();
@albums = ();

@play_artists = ();
@play_categories = ();
@play_albums = ();



#
# Directory structure organization:
#
#   Music/<Category>/<Artist>/<Album>/<Track>.flac
#
while($run) {

   print("Building Album List");

   #
   # Check category directories
   #
   foreach $category (`ls $mount/`) {
      chomp($category);

      #
      # List of all categories for manipulating play list later.
      #
      push(@categories, $category);

      #
      # List of categories to play now.
      #
      if(!defined($opt_c) || ($category =~ m/$opt_c/)) {
	 $play_categories{$category} = $category;
	 push(@play_categories, $category);
      }


      #
      # Check artist directories
      #
      foreach $artist (`ls $mount/$category/`) {
	 chomp($artist);

	 #
	 # List of all artists
	 #
	 push(@artists, $artist);

	 #
	 # If -a option only want to play artists matching name..
	 # List of artists to play now.
	 #
	 if(defined($play_categories{$category}) &&
	     (!defined($opt_a) || ($artist =~ m/$opt_a/))) {

	    $play_artists{$artist} = $artist;
	    push(@play_artists, $artist);
	 }


	 #
	 # Check album directories
	 #
	 foreach $album (`ls $mount/$category/$artist | sort`) {
	    print(".");

	    chomp($album);

	    #
	    # For multi-disk albums, only remember disc 1.
	    # Play multi-disk albums all together later...
	    #
	    if($album =~ m/dis[ck]_?(\d+)/i) {
	       $disk_num = $1;
	       next unless($disk_num =~ m/0*1/);
	    }

	    #
	    # All Album names
	    #
	    push(@album_names, $album);

	    $album_path = "${mount}/${category}/${artist}/${album}";

	    #
	    # Build lists of albums.
	    #
	    push(@{$albums{$category}}, $album_path);
	    push(@{$albums{$artist}}, $album_path);

	    #
	    # List of album full paths.
	    #
	    push(@albums, $album_path);

	    #	    $last_track = `ls $album_path | tail -1`;
	    #	    $last_track{$album_path} = "${mount}/${category}/${artist}/${album}/${last_track}";

	    #
	    # -l option only play matching albums.
	    #
	    if(defined($play_categories{$category}) && defined($play_artists{$artist})) {
	       if(!defined($opt_l) || ($album =~ m/$opt_l/)) {
		  push(@play_albums, "${mount}/${category}/${artist}/${album}");
	       }
	    }
	 }
      }
   }

   #
   # Start streaming albums
   #
   print("\n\n======================== PIDAP! ================================\n\n");

   #
   # Use a saved playlist if it exists and no filters are in effect.
   # Filters change the album set, so we always build fresh for those.
   #
   my $using_filters = (defined($opt_c) || defined($opt_a) || defined($opt_l));
   my $loaded_playlist = 0;
   my @disk_albums = @play_albums;

   if (!$using_filters && -r $playlist_file) {
      my @saved = &read_playlist_file($playlist_file);
      if (@saved) {
         my %disk = map { $_ => 1 } @disk_albums;
         my @valid = grep { -d $_ && $disk{$_} } @saved;
         if (@valid) {
            @play_albums = @valid;
            $loaded_playlist = 1;
            print("Using saved playlist order\n");
         } else {
            print("Warning: saved playlist is out of date, rebuilding\n");
            unlink($playlist_file) if -e $playlist_file;
         }
      }
   }

   #
   # No saved playlist: build a fresh one, shuffle it, and save it.
   #
   unless ($loaded_playlist) {
      @play_albums = &rand_array(@play_albums);

      if (!$using_filters) {
         if (open(my $cf, '>', $playlist_file)) {
            foreach $jj (0 .. $#play_albums) {
               printf($cf "CUESHEET:%7d %s\n", $jj, $play_albums[$jj]);
            }
            close($cf);
         } else {
            print "Warning: could not write $playlist_file: $!\n";
         }
         unlink($place_file) if -e $place_file;
      }
   }

   #
   # Restore resume position if paused before shutdown.
   #
   ($resume_album, $resume_offset) = &read_resume;
   if ($resume_album) {
      my $found = 0;
      for my $i (0 .. $#play_albums) {
         if ($play_albums[$i] eq $resume_album) {
            $first_lp = $i;
            $found = 1;
            last;
         }
      }
      unless ($found) {
         print "Warning: resume album $resume_album not in playlist, ignoring\n";
         $resume_album = '';
         $resume_offset = 0;
         unlink($resume_file) if -e $resume_file;
      }
   }

   #
   # Otherwise, restore our place in the playlist.
   #
   unless ($resume_album) {
      my $place = &read_place_file($place_file);
      if ($place > 0 && $place <= $#play_albums) {
         $first_lp = $place;
         print("Resuming playlist at index $first_lp: $play_albums[$first_lp]\n");
      } elsif ($place > $#play_albums && $place > 0) {
         print("Playlist was finished; starting over\n");
         unlink($place_file) if -e $place_file;
         $first_lp = 0;
      }
   }

   #
   # Print out cuesheet unless quiet mode.
   #
   unless(defined($opt_q)) {
      foreach $jj (0 .. $#play_albums) {
         printf("CUESHEET:%7d %s\n", $jj, $play_albums[$jj]);
      }
   }

   &play_albums(@play_albums);

   #
   # Loop back to the beginning when the playlist finishes.
   # If we were interrupted, the place file still exists and we
   # resume from there. Use -p to stop after one pass.
   #
   last if(defined($opt_p));
   if (-e $place_file) {
      next;
   }
   $first_lp = 0;
   next;
}


#
#
#
sub start_gpio_handler() {

   my $handler = "$FindBin::Bin/pidap_buttons.py";

   unless(-r $handler) {
      print "Warning: $handler not found, button control disabled\n";
      return 0;
   }

   print "Forking GPIO button handler: $handler\n";

   my $pid = fork;
   die "Failed to fork GPIO handler\n" unless defined $pid;

   if($pid == 0) {
      exec("python3", $handler) or die "Failed to exec $handler: $!\n";
   }

   print "GPIO handler pid: $pid\n";
   return $pid;
}


sub write_play_pid() {

   my ($pid) = (@_);

   return unless $pid;

   open(PIDF, ">$play_pid_file") or return;
   print PIDF "$pid\n";
   close(PIDF);
}


sub set_initial_volume {

   my $control = $ENV{PIDAP_VOLUME_CONTROL} || 'Amp';
   my $initial = $ENV{PIDAP_INITIAL_VOLUME} || 40;
   my $max = 20;
   my $attempt = 0;

   while($attempt < $max) {
      my $rc = system("amixer sset $control ${initial}% >/dev/null 2>&1");
      if($rc == 0) {
	 print("Initial volume set to ${initial}%\n");
	 return;
      }
      Time::HiRes::usleep(200_000);
      $attempt++;
   }

   print("Warning: could not set initial volume to ${initial}%\n");
}


sub read_resume {
   my ($album, $offset) = ('', 0);
   if (-r $resume_file) {
      if (open(my $rf, '<', $resume_file)) {
         while (<$rf>) {
            chomp;
            if (/^album=(.+)/) { $album = $1; }
            elsif (/^offset=([0-9.]+)/) { $offset = $1; }
         }
         close($rf);
      }
   }
   return ($album, $offset);
}

sub get_album_offsets {
   my ($album) = @_;
   my @files = sort glob("${album}*/*.flac");
   my @durations;
   my @offsets;
   my $cum = 0;
   for my $f (@files) {
      my $d = soxi_duration($f);
      push @durations, $d;
      push @offsets, $cum;
      $cum += $d;
   }
   return (\@files, \@durations, \@offsets, $cum);
}

sub write_current_album {
   my ($album, $start_offset, $files, $durations) = @_;
   return unless $album;
   $start_offset ||= 0;
   if (open(my $cf, '>', $current_album_file)) {
      print $cf "album=$album\noffset=$start_offset\n";
      if ($files && $durations && @$files) {
	 for my $i (0 .. $#$files) {
	    print $cf "track:$i:$durations->[$i]=$files->[$i]\n";
	 }
      }
      close($cf);
   } else {
      print "Warning: could not write $current_album_file: $!\n";
   }
}

sub soxi_duration {
   my ($file) = @_;
   my $out = `soxi -D "$file" 2>/dev/null`;
   return 0 unless defined $out && $out =~ /^([0-9.]+)/;
   return $1 + 0;
}

sub build_resume_cmd {
   my ($album, $offset, $files, $durations) = @_;
   return undef unless $files && @$files;

   my $cum = 0;
   my $idx = 0;
   my $track_offset = 0;
   for my $i (0 .. $#$files) {
      my $d = $durations->[$i];
      $cum += $d;
      if ($cum > $offset) {
         $idx = $i;
         $track_offset = $offset - ($cum - $d);
         last;
      }
   }
   my @remaining = @$files[$idx .. $#$files];
   my $cmd = 'play ' . join(' ', map { "\"$_\"" } @remaining);
   if ($track_offset > 0) {
      $cmd .= ' trim ' . sprintf('%.2f', $track_offset);
   }
   return $cmd;
}

sub read_playlist_file {
   my ($file) = @_;
   my @paths = ();
   if (open(my $pf, '<', $file)) {
      while (<$pf>) {
         chomp;
         next unless $_;
         if (m/^\s*(?:CUESHEET:\s*)?\d+\s+(.+)$/) {
            push @paths, $1;
         } elsif (m/^(.+)$/) {
            push @paths, $1;
         }
      }
      close($pf);
   }
   return @paths;
}

sub read_place_file {
   my ($file) = @_;
   return 0 unless -r $file;
   if (open(my $pf, '<', $file)) {
      my $line = <$pf>;
      close($pf);
      return 0 unless defined $line;
      chomp $line;
      return $1 if $line =~ /^(\d+)$/;
   }
   return 0;
}

sub write_place_file {
   my ($file, $index) = @_;
   if (open(my $pf, '>', $file)) {
      print $pf "$index\n";
      close($pf);
   } else {
      print "Warning: could not write $file: $!\n";
   }
}

sub play_albums() {

   my (@albums) = (@_);

   #
   # Loop through albums and play all tracks in album folder.
   #
   my $volume_initialized = 0;
   for ($ii = $first_lp; $ii <= $#albums; $ii++) {
      print("Album Name: $albums[$ii]\n");
      $play_album = $albums[$ii];

      #
      # Does this album end with disk_<n>?
      # Cut off the disk number and play them all
      #
      if($play_album =~ m/(dis(c|k)_?(\d+))/i) {
	 ($disc_name, $ck, $disc_num) = ($1, $2, $3);

	 print("DISC_NAME=$disc_name DISC_NUM=$disc_num\n");

	 $play_album =~ s/$disc_num//;
      }

      unless(defined($opt_p)) {
	 #
	 # Remember where we are in the playlist.
	 #
	 &write_place_file($place_file, $ii);

	 #
	 # Clear any stale restart request before starting playback.
	 #
	 unlink("pidap.generated.restart") if(-e "pidap.generated.restart");

	 #
	 # Precompute the track boundaries for this album so the button
	 # handler can map playback time to tracks without calling soxi.
	 #
	 my ($files, $durations, $offsets, $total) = &get_album_offsets($play_album);

	 #
	 # Flash the LED while loading/starting the next album, then
	 # turn it off once the play process is running.
	 #
	 &led_flash();

	 my $play_start_offset = 0;
	 $play_id = 0;

	 #
	 # Fork off process to stream music.
	 # Use <Album_Name>*/*.flac to catch all disc numbers.
	 #
	 if ($resume_album && $play_album eq $resume_album && $resume_offset > 0) {
	    $play_start_offset = $resume_offset;
	    &write_current_album($play_album, $resume_offset, $files, $durations);
	    my $resume_cmd = &build_resume_cmd($play_album, $resume_offset, $files, $durations);
	    if ($resume_cmd) {
	       print("Resuming $play_album at offset $resume_offset\n");
	       $play_id = &print_run($resume_cmd);
	       $first_lp = 0;
	    } else {
	       print("Warning: could not build resume command for $play_album\n");
	    }
	    $resume_album = '';
	    $resume_offset = 0;
	    unlink($resume_file) if -e $resume_file;
	 } else {
	    &write_current_album($play_album, 0, $files, $durations);
	    $play_id = &print_run("play ${play_album}*/*.flac");
	 }

	 &led_off();

	 #
	 # Record play pid for the GPIO button handler
	 #
	 &write_play_pid($play_id);

	 #
	 # Set the initial playback volume once on first start.
	 #
	 if (!$volume_initialized) {
	    &set_initial_volume;
	    $volume_initialized = 1;
	 }

	 #
	 # Wait for streaming to finish for this lp, blinking the LED each
	 # time the playback position crosses a track boundary.
	 #
	 if ($play_id > 0) {
	    my $start_time = Time::HiRes::time();
	    my $track_blink_until = 0;
	    my $next_offset_idx = 0;
	    for my $i (0 .. $#$offsets) {
	       last if $offsets->[$i] > $play_start_offset + 0.05;
	       $next_offset_idx = $i + 1;
	    }

	    # Show the track that is playing now on the TFT.
    my $current_track_idx = ($next_offset_idx > 0) ? ($next_offset_idx - 1) : 0;
    &update_display($play_album, $files->[$current_track_idx]);

	    if ($play_start_offset > 0.05) {
	       for my $i (0 .. $#$offsets) {
	          if (abs($offsets->[$i] - $play_start_offset) < 0.05) {
	             &led_track_blink();
	             $track_blink_until = $start_time + 0.15;
	             last;
	          }
	       }
	    }

	    # Detect play pauses via /proc and account for pause time so
	    # track display/LEDs stay in sync with actual playback.
	    my $paused = 0;
	    my $pause_start = 0;
	    my $total_pause_time = 0.0;

	    while ($play_id > 0) {
	       my $res = waitpid($play_id, WNOHANG);
	       if ($res == 0) {
		  #
		  # If the button handler asked for previous/restart and the play
		  # family is still running, force a group kill so we can exit the
		  # loop and act on the flag.  The child setpgrp above makes this
		  # safe: the group id is the play child's pid, not pidap's group.
		  #
		  if (-e "pidap.generated.previous" || -e "pidap.generated.restart") {
		     print("Forcing play family kill for button request\n");
		     kill(9, -$play_id);
		  }
	       }
	       last if $res > 0 || $res == -1;
	       my $now = Time::HiRes::time();

	       # Detect whether the play process is paused (State: T) and
	       # correct the album clock so it does not advance while paused.
	       my $play_state = '0';
	       if (open(my $st, '<', "/proc/$play_id/status")) {
	          while (<$st>) {
	             $play_state = $1 if /^State:\s*(\S)/;
	          }
	          close($st);
	       }
	       if ($play_state eq 'T' && !$paused) {
	          $paused = 1;
	          $pause_start = $now;
	       } elsif ($play_state ne 'T' && $paused) {
	          $paused = 0;
	          $total_pause_time += ($now - $pause_start);
	       }
	       my $effective_pause = $total_pause_time + ($paused ? ($now - $pause_start) : 0);
	       my $album_time = $play_start_offset + ($now - $start_time - $effective_pause);
	      if ($next_offset_idx < @$offsets && $album_time >= $offsets->[$next_offset_idx] - 0.05 && !$paused) {
         &led_track_blink();
         &update_display($play_album, $files->[$next_offset_idx]);
         $track_blink_until = $now + 0.15;
         $next_offset_idx++;
      }
	       if ($track_blink_until && $now >= $track_blink_until) {
	          &led_off();
	          $track_blink_until = 0;
	       }
	       Time::HiRes::usleep(50_000);
	    }
	    &led_off();
	 }

	 #
	 # If the button handler requested the previous album, back up.
	 #
	 if(-e "pidap.generated.previous") {
	    unlink("pidap.generated.previous");
	    print("Previous album\n");
	    if($ii > 0) {
	       $ii -= 2;
	    } else {
	       $ii = $#albums - 1;
	    }
	    next;
	 }

	 #
	 # If the button handler requested a restart, replay this album.
	 # If the file contains an offset, resume from that position.
	 #
	 if(-e "pidap.generated.restart") {
	    my $restart_offset = 0;
	    if(open(my $rf, '<', "pidap.generated.restart")) {
	       while(<$rf>) {
		  chomp;
		  $restart_offset = $1 if(/^offset=([0-9.]+)/);
	       }
	       close($rf);
	    }
	    unlink("pidap.generated.restart");
	    if($restart_offset > 0) {
	       $resume_album = $play_album;
	       $resume_offset = $restart_offset;
	    }
	    print("Restarting current album");
	    print(" at offset $resume_offset") if $resume_offset;
	    print("\n");
	    redo;
	 }
      }
   }

   #
   # Reached the end of the playlist; clear the saved place.
   #
   unlink($place_file) if -e $place_file;

   &led_off();
}

#
# Update the TFT display with the current artist/album/track.
#
sub update_display {
    my ($album_path, $track_file) = @_;
    return unless $album_path && $track_file;

    my @parts = split(m{/}, $album_path);
    return if @parts < 2;
    my $album_name  = $parts[-1];
    my $artist_name = $parts[-2];

    my $track_name = $track_file;
    $track_name =~ s{^.*/}{};
    $track_name =~ s{\.(?:flac|mp3|ogg|m4a|wav)$}{}i;

    my $display = "$FindBin::Bin/pidap_display";
    return unless -x $display;

    my $pid = fork;
    return unless defined $pid;

    if ($pid == 0) {
        open(STDOUT, '>/dev/null') or die;
        open(STDERR, '>/dev/null') or die;
        exec($display, '-a', $artist_name, '-l', $album_name, '-t', $track_name);
        exit;
    }
}

#
# Print command and system run it.
#
sub print_run() {
   ($cmd) = (@_);

   #
   #
   #
   print("$cmd\n");

   my $pid = fork;
   die "Failed to fork $!\n" unless defined $pid;

   #
   # Child process only.
   #
   if($pid == 0) {

      #
      # Put the play process and its descendants (sox, aplay, ...) into
      # their own process group.  This lets us kill the whole family with
      # one signal to the group id.
      #
      setpgrp $$, $$;

      system($cmd);
      exit;
   }

   #
   # Main process, pass back new child PID
   #
   return $pid;
}


#
# LED control helpers.
#
sub led_write {
   my ($file, $val) = @_;
   return unless $file;
   open(my $fh, '>', $file) or return;
   print $fh $val;
   close($fh);
}

sub led_init {
   led_off();
}

sub led_flash {
   return unless $led_brightness;
   if($led_trigger) {
      led_write($led_brightness, 1);
      led_write($led_trigger, 'timer');
      (my $base = $led_trigger) =~ s{/trigger$}{};
      led_write("$base/delay_on", 900);
      led_write("$base/delay_off", 900);
   } else {
      led_write($led_brightness, 1);
   }
}

sub led_track_blink {
   return unless $led_brightness;
   if($led_trigger) {
      led_write($led_brightness, 1);
      led_write($led_trigger, 'timer');
      (my $base = $led_trigger) =~ s{/trigger$}{};
      led_write("$base/delay_on", 100);
      led_write("$base/delay_off", 100);
   } else {
      led_write($led_brightness, 1);
   }
}

sub led_off {
   return unless $led_brightness;
   led_write($led_trigger, 'none') if $led_trigger;
   led_write($led_brightness, 0);
}


#
# Randomize array order.
# Thanks to Perl.LiveJournal.com
# https://perl.livejournal.com/101830.html
#
sub rand_array {
   my @array = @_;
   my @rand;
   while (@array) {
      my $i = int(rand(@array));
      my $random_item = $array[$i];
      push @rand, $random_item;
      splice(@array, $i, 1);
   }
   return @rand;
}
